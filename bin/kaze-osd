#!/usr/bin/env lua

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local q = "'" .. script:gsub("'", "'\\''") .. "'"
    local p = io.popen("readlink -f " .. q .. " 2>/dev/null")
    local resolved = p and p:read("*l") or nil
    if p then
        p:close()
    end
    local base = (resolved or script):match("^(.*)/[^/]+$")
    if base then
        local repo_lua = base .. "/../lua"
        local f = io.open(repo_lua .. "/kaze/defaults.lua", "r")
        if f then
            f:close()
            paths[#paths + 1] = repo_lua .. "/?.lua"
            paths[#paths + 1] = repo_lua .. "/?/init.lua"
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
end

setup_path()

local config = require("kaze.config")
local fs = require("kaze.fs")

local VALID_ACTIONS = {
    ["vol-up"] = true,
    ["vol-down"] = true,
    ["vol-mute"] = true,
    ["mic-mute"] = true,
    ["bright-up"] = true,
    ["bright-down"] = true,
}

local action = arg[1]
if action == "-h" or action == "--help" then
    io.stdout:write("Usage: kaze-osd <vol-up|vol-down|vol-mute|mic-mute|bright-up|bright-down>\n")
    os.exit(0)
end

if not action or not VALID_ACTIONS[action] then
    io.stderr:write(string.format(
        "kaze-osd: invalid action '%s' (expected: vol-up, vol-down, vol-mute, mic-mute, bright-up, bright-down)\n",
        tostring(action or "")
    ))
    os.exit(1)
end

local function cmd_exists(bin)
    local ok = os.execute("command -v " .. fs.shell_quote(bin) .. " >/dev/null 2>&1")
    return ok == true or ok == 0
end

local function clamp_pct(v)
    local n = math.floor((tonumber(v) or 0) + 0.5)
    if n < 0 then
        return 0
    end
    if n > 100 then
        return 100
    end
    return n
end

local function send_osd(title, body, pct)
    local cmd = string.format(
        "exec notify-send -a kaze-osd -t 1400 -u low -h string:x-canonical-private-synchronous:kaze-osd -h int:value:%d %s %s >/dev/null 2>&1",
        clamp_pct(pct),
        fs.shell_quote(title),
        fs.shell_quote(body)
    )
    os.execute(cmd)
end

local ok_cfg, cfg = pcall(config.load, { strict = false })
if not ok_cfg or type(cfg) ~= "table" then
    cfg = { vol_step = 5, vol_max = 1.5, bright_step = 5 }
end

local function require_cmd(bin)
    if cmd_exists(bin) then return end
    io.stderr:write("kaze-osd: " .. bin .. " not found in PATH\n")
    os.exit(1)
end

local function step(value)
    return math.floor(math.max(1, math.min(100, tonumber(value) or 5)))
end

if action:match("^bright-") then
    require_cmd("brightnessctl")
    -- Limit to a panel backlight, never an LED (e.g. a keyboard on a desktop).
    local info = fs.capture("exec brightnessctl -c backlight -m 2>/dev/null")
    if not info then os.exit(0) end
    local device, max = info:match("^([^,\n]+),backlight,%d+,%d+%%,(%d+)")
    max = tonumber(max)
    if not max or max < 1 then os.exit(0) end
    local floor = math.max(1, (max + 49) // 50)
    local delta = step(cfg.bright_step) .. (action == "bright-up" and "%+" or "%-")
    local out = fs.capture(string.format("exec brightnessctl -c backlight -d %s -n %d -m set %s 2>/dev/null",
        fs.shell_quote(device), floor, fs.shell_quote(delta)))
    local pct = out and tonumber(out:match(",(%d+)%%,"))
    if pct then send_osd("󰃠  Brightness", string.format("%d%%", pct), pct) end
    os.exit(0)
end

require_cmd("wpctl")
local mic = action == "mic-mute"
local target = mic and "@DEFAULT_AUDIO_SOURCE@" or "@DEFAULT_AUDIO_SINK@"
local change
if action == "vol-up" or action == "vol-down" then
    local max = tonumber(cfg.vol_max) or 1.5
    change = string.format("wpctl set-mute %s 0 && wpctl set-volume -l %s %s %d%%%s",
        target, tostring(max), target, step(cfg.vol_step), action == "vol-up" and "+" or "-")
else
    change = "wpctl set-mute " .. target .. " toggle"
end
local out = fs.capture("{ " .. change .. " && exec wpctl get-volume " .. target .. "; } 2>/dev/null")
local raw = out and tonumber(out:match("Volume:%s*([%d%.]+)"))
if not raw then os.exit(0) end  -- No default device or PipeWire connection.
local pct = math.floor(raw * 100 + 0.5)
local muted = out:find("[MUTED]", 1, true) ~= nil
local volume_icon = pct >= 60 and "󰕾" or (pct >= 25 and "󰖀" or "󰕿")
if mic then
    send_osd(muted and "󰍭  Microphone" or "󰍬  Microphone", muted and "Muted" or string.format("%d%%", pct), muted and 0 or pct)
else
    send_osd(muted and "󰖁  Volume" or volume_icon .. "  Volume", string.format(muted and "Muted (%d%%)" or "%d%%", pct), muted and 0 or pct)
end
