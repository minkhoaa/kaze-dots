#!/usr/bin/env lua

local script_dir

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local q = "'" .. script:gsub("'", "'\\''") .. "'"
    local p = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
    local resolved = p and p:read("*l") or nil
    if p then
        p:close()
    end
    script_dir = (resolved or script):match("^(.*)/[^/]+$")
    if script_dir then
        local repo_lua = script_dir .. "/../lua"
        local f = io.open(repo_lua .. "/kaze/defaults.lua", "r")
        if f then
            f:close()
            paths[#paths + 1] = repo_lua .. "/?.lua"
            paths[#paths + 1] = repo_lua .. "/?/init.lua"
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
end

setup_path()

local config = require("kaze.config")
local fs = require("kaze.fs")
local layouts = require("kaze.layouts")
local notify = require("kaze.notify")
local popups = require("kaze.popups")

local function cmd_exists(bin)
    local ok = os.execute("command -v " .. fs.shell_quote(bin) .. " >/dev/null 2>&1")
    return ok == true or ok == 0
end

local function sibling_or_path(bin)
    if script_dir and fs.file_exists(script_dir .. "/" .. bin) then
        return script_dir .. "/" .. bin
    end
    return bin
end

local function usage()
    io.stdout:write("Usage: kaze-layout [--quiet] [sidebar|islands|slim|--menu|--current|-h|--help]\n")
end

local function pick_from_menu(current_layout, active_theme)
    if popups.toggle_existing_fuzzel("kaze-layout") then
        return nil
    end
    if not cmd_exists("fuzzel") then
        io.stderr:write("kaze-layout: fuzzel not found in PATH\n")
        os.exit(1)
    end

    local dmenu_entries = {}
    local active_idx = nil
    for idx, name in ipairs(layouts.list()) do
        local spec = layouts.get(name)
        local marker = (name == current_layout) and " (active)" or ""
        dmenu_entries[#dmenu_entries + 1] = {
            text = string.format("%s  —  %s%s", name, spec.label, marker),
            icon = popups.ensure_layout_swatch(name, active_theme),
        }
        if name == current_layout then
            active_idx = idx - 1
        end
    end

    local trimmed, dmenu_err = popups.run_dmenu(dmenu_entries, {
        flags = popups.active_right_flags(),
        width = 56,
        lines = #dmenu_entries,
        minimal_lines = true,
        hide_prompt = true,
        line_height = 36,
        select_index = active_idx,
        prompt = "Layout > ",
        tag = "kaze-layout",
    })
    if not trimmed then
        io.stderr:write("kaze-layout: " .. tostring(dmenu_err) .. "\n")
        os.exit(1)
    end
    if trimmed == "" then
        return nil
    end
    return trimmed:match("^(%S+)")
end

local quiet = false
local mode = nil
for i = 1, #arg do
    local a = arg[i]
    if a == "-q" or a == "--quiet" then
        quiet = true
    elseif a == "-h" or a == "--help" then
        usage()
        os.exit(0)
    elseif mode == nil then
        mode = a
    else
        io.stderr:write("kaze-layout: too many arguments\n")
        usage()
        os.exit(2)
    end
end

if mode == "--current" then
    io.stdout:write(config.load({ strict = false }).layout .. "\n")
    os.exit(0)
end

local target = mode
if not target or target == "--menu" then
    local cur_cfg, cur_theme = config.load({ strict = false })
    target = pick_from_menu(cur_cfg.layout, cur_theme)
    if not target then
        os.exit(0)
    end
elseif target:sub(1, 1) == "-" then
    io.stderr:write(string.format("kaze-layout: unknown option '%s'\n", target))
    usage()
    os.exit(2)
end

local ok_spec, spec = pcall(layouts.get, target)
if not ok_spec then
    io.stderr:write(string.format("kaze-layout: %s\n", tostring(spec)))
    os.exit(1)
end

local sync_bin = sibling_or_path("kaze-sync")
if not os.execute(fs.shell_quote(sync_bin) .. " --set-layout " .. fs.shell_quote(spec.name)) then
    io.stderr:write("kaze-layout: switch failed\n")
    os.exit(1)
end

local hypr_sig = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
local wl_disp = os.getenv("WAYLAND_DISPLAY")
if not quiet and ((hypr_sig and hypr_sig ~= "") or (wl_disp and wl_disp ~= "")) and cmd_exists("notify-send") then
    notify.record({
        app = "kaze-layout",
        icon = "󰙵",
        urgency = "low",
        summary = "Layout switched",
        body = "Active: " .. spec.label,
    })
    os.execute(string.format(
        "notify-send -a kaze-layout -t 1800 -u low -h string:x-canonical-private-synchronous:kaze-switch %s %s >/dev/null 2>&1 || true",
        fs.shell_quote("Layout switched"),
        fs.shell_quote("Active: " .. spec.label)
    ))
end
