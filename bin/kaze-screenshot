#!/usr/bin/env lua

local mode = arg[1]
local save = arg[2] == "--save"
local annotate = arg[2] == "--annotate" and mode == "region"
if (mode ~= "screen" and mode ~= "region" and mode ~= "color")
    or #arg > ((annotate or (save and mode ~= "color")) and 2 or 1) then
    local help = #arg == 1 and (mode == "--help" or mode == "-h")
    local stream = help and io.stdout or io.stderr
    stream:write("Usage: kaze-screenshot <screen|region> [--save] | region --annotate | color\n")
    os.exit(help and 0 or 2)
end

local script = arg[0]:gsub("'", "'\\''")
local link = io.popen("readlink -f -- '" .. script .. "' 2>/dev/null")
local resolved = link and link:read("*l")
if link then link:close() end
local repo = ((resolved or arg[0]):match("^(.*)/[^/]+$") or ".") .. "/../lua"
local data = os.getenv("XDG_DATA_HOME") or ""
if data == "" then data = (os.getenv("HOME") or "") .. "/.local/share" end
local installed = data .. "/kaze-dots/lua"
package.path = table.concat({ repo .. "/?.lua", repo .. "/?/init.lua",
    installed .. "/?.lua", installed .. "/?/init.lua", package.path }, ";")

local fs = require("kaze.fs")
local capture = require("kaze.capture")
local quote = fs.shell_quote
local tmp
local function fail(msg)
    if tmp then os.remove(tmp) end
    io.stderr:write("kaze-screenshot: " .. msg .. "\n")
    os.exit(1)
end

local function require_cmd(bin)
    if not fs.command_exists(bin) then fail(bin .. " not found in PATH") end
end

if mode == "color" then
    require_cmd("hyprpicker")
    require_cmd("wl-copy")
    -- Do not use hyprpicker's autocopy or notify options: only a successful,
    -- validated pick may replace the current clipboard or show a toast.
    local result = fs.capture("hyprpicker --no-fancy --format=hex")
    local color = result and result:match("^%s*(#%x%x%x%x%x%x)%s*$")
    if not color then return end
    if not os.execute("printf %s " .. quote(color) .. " | wl-copy --type text/plain >/dev/null 2>&1") then fail("wl-copy failed") end
    os.execute("notify-send -t 2000 -- Color " .. quote(color) .. " 2>/dev/null")
    return
end

require_cmd("grim")
if annotate then require_cmd("swappy") elseif not save then require_cmd("wl-copy") end
local region = ""
if mode == "region" then
    require_cmd("slurp")
    local geom = (fs.capture("slurp </dev/null") or ""):gsub("\n$", "")
    if geom == "" then os.exit(0) end  -- Esc: no capture, clipboard changes, file or toast.
    region = " -g " .. quote(geom)
end

local dir = fs.private_runtime_dir()
if not dir then fail("cannot prepare $XDG_RUNTIME_DIR/kaze") end
tmp = fs.capture("mktemp -- " .. quote(dir .. "/screenshot.XXXXXXXX.png"))
if not tmp then fail("cannot create a temporary file") end
tmp = tmp:gsub("\n$", "")
local payload = quote(tmp)
if not os.execute("grim -t png" .. region .. " " .. payload .. " && test -s " .. payload) then
    fail("grim did not produce a screenshot")
end

if annotate then
    local ok = os.execute("swappy -f " .. payload)
    if not ok then fail("swappy failed") end
    os.remove(tmp)
    return
end

local message
if save then
    dir = capture.directory("PICTURES", "Pictures", "Screenshots")
    local dest = capture.reserve(dir, "png")
    if not dest then fail("cannot create a file in " .. dir) end
    if not os.execute("cp -- " .. payload .. " " .. quote(dest)) then
        os.remove(dest)
        fail("could not save " .. dest)
    end
    io.stdout:write(dest .. "\n")
    message = "Saved to " .. dest
else
    if not os.execute("wl-copy --type image/png < " .. payload .. " >/dev/null 2>&1") then fail("wl-copy failed") end
    message = mode == "region" and "Region copied" or "Full screen copied"
end
os.remove(tmp)
os.execute("notify-send -t 2000 Screenshot " .. quote(message) .. " 2>/dev/null")
