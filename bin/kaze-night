#!/usr/bin/env lua

local home = os.getenv("HOME") or ""
local data = os.getenv("XDG_DATA_HOME") or ""
if data == "" then data = home .. "/.local/share" end

local script = arg and arg[0] or ""
local script_dir = script:match("^(.*)/[^/]+$")
local repo = script_dir and (script_dir .. "/../lua") or nil
local found = false

if repo then
    local f = io.open(repo .. "/kaze/defaults.lua", "r")
    if f then
        f:close()
        found = true
    end
end

if not found then
    local f_inst = io.open(data .. "/kaze-dots/lua/kaze/defaults.lua", "r")
    if f_inst then
        f_inst:close()
        repo = nil
    else
        local q = "'" .. script:gsub("'", "'\\''") .. "'"
        local p = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
        local resolved = p and p:read("*l") or nil
        if p then p:close() end
        script_dir = (resolved or script):match("^(.*)/[^/]+$")
        if script_dir then
            repo = script_dir .. "/../lua"
        end
    end
end

local paths = {}
if repo then
    paths[#paths + 1] = repo .. "/?.lua"
    paths[#paths + 1] = repo .. "/?/init.lua"
end
paths[#paths + 1] = data .. "/kaze-dots/lua/?.lua"
paths[#paths + 1] = data .. "/kaze-dots/lua/?/init.lua"
paths[#paths + 1] = package.path
package.path = table.concat(paths, ";")

require("kaze.utility").toggle("kaze-night", "kaze-night.service", "hyprsunset", arg)
