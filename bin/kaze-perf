#!/usr/bin/env lua

local action = arg[1] or "toggle"
local quiet = false
local parsed_action = nil
for i = 1, #arg do
    local a = arg[i]
    if a == "-q" or a == "--quiet" then
        quiet = true
    elseif a == "-h" or a == "--help" then
        io.stdout:write("Usage: kaze-perf [--quiet] [on|off|toggle|status]\n")
        os.exit(0)
    elseif not parsed_action and ({ on = true, off = true, toggle = true, status = true })[a] then
        parsed_action = a
    else
        io.stderr:write("Usage: kaze-perf [--quiet] [on|off|toggle|status]\n")
        os.exit(2)
    end
end
action = parsed_action or "toggle"

local script = arg and arg[0] or ""
local data = os.getenv("XDG_DATA_HOME") or ""
if data == "" then data = (os.getenv("HOME") or "") .. "/.local/share" end
local installed = data .. "/kaze-dots/lua"
local direct_dir = script:match("^(.*)/[^/]+$")
local repo = direct_dir and (direct_dir .. "/../lua") or nil
local f_repo = repo and io.open(repo .. "/kaze/defaults.lua", "r") or nil
if f_repo then
    f_repo:close()
else
    local f_inst = io.open(installed .. "/kaze/defaults.lua", "r")
    if f_inst then
        f_inst:close()
        repo = nil
    else
        local q = "'" .. script:gsub("'", "'\\''") .. "'"
        local link = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
        local resolved = link and link:read("*l")
        if link then link:close() end
        repo = ((resolved or script):match("^(.*)/[^/]+$") or ".") .. "/../lua"
    end
end
local paths = {}
if repo then
    paths[#paths + 1] = repo .. "/?.lua"
    paths[#paths + 1] = repo .. "/?/init.lua"
end
paths[#paths + 1] = installed .. "/?.lua"
paths[#paths + 1] = installed .. "/?/init.lua"
paths[#paths + 1] = package.path
package.path = table.concat(paths, ";")

local fs = require("kaze.fs")
local notify_store = require("kaze.notify")

local function fail(msg)
    io.stderr:write("kaze-perf: " .. msg .. "\n")
    os.exit(1)
end

local dir = fs.private_runtime_dir()
if not dir then
    fail("cannot prepare $XDG_RUNTIME_DIR/kaze")
end
local state_file = dir .. "/perf.state"
local active = fs.file_exists(state_file)

if action == "status" then
    io.stdout:write((active and "on" or "off") .. "\n")
    os.exit(0)
end

if not fs.command_exists("hyprctl") then
    fail("hyprctl not found in PATH")
end

local target = action
if target == "toggle" then
    target = active and "off" or "on"
end

local function waybar_mapped()
    local layers = fs.capture("timeout 1s hyprctl layers 2>/dev/null")
    return layers ~= nil and layers:find("namespace: waybar", 1, true) ~= nil
end

local function waybar_running()
    return os.execute("pgrep -x waybar >/dev/null 2>&1") == true
        or os.execute("pgrep -x waybar >/dev/null 2>&1") == 0
end

local function waybar_unit_loaded()
    if not fs.command_exists("systemctl") then
        return false
    end
    local out = fs.capture("systemctl --user show -p LoadState --value kaze-waybar.service 2>/dev/null")
    return out ~= nil and out:match("^loaded") ~= nil
end

local function notify(body)
    if quiet or not fs.command_exists("notify-send") then
        return
    end
    notify_store.record({
        app = "kaze-perf",
        icon = "󱐋",
        urgency = "low",
        summary = "Zen Performance Mode",
        body = body,
    })
    os.execute(string.format(
        "notify-send -a kaze-perf -t 1400 -u low -h string:x-canonical-private-synchronous:kaze-switch %s %s >/dev/null 2>&1 || true",
        fs.shell_quote("Zen Performance Mode"),
        fs.shell_quote(body)
    ))
end

if target == "on" then
    local lua_eval = [[
hl.config({
    animations = { enabled = false },
    decoration = {
        rounding = 0,
        active_opacity = 1.0,
        inactive_opacity = 1.0,
        blur = { enabled = false },
        shadow = { enabled = false },
    },
    general = {
        gaps_in = 0,
        gaps_out = 0,
    },
})
]]
    local out = fs.capture("timeout 3s hyprctl eval " .. fs.shell_quote(lua_eval))
    if not (out and out:match("^%s*ok%s*$")) then
        fail("hyprctl eval rejected Zen Mode config")
    end
    if waybar_unit_loaded() then
        local active_ok = os.execute("systemctl --user is-active --quiet kaze-waybar.service >/dev/null 2>&1")
        if active_ok == true or active_ok == 0 then
            os.execute("systemctl --user stop kaze-waybar.service >/dev/null 2>&1 || true")
        end
    elseif waybar_running() and waybar_mapped() then
        os.execute("pkill --signal USR1 -x --require-handler waybar >/dev/null 2>&1 || true")
    end
    fs.write_atomic(state_file, "on\n")
    notify("Enabled (0 gaps, blur/animations off, bar stopped)")
else
    os.remove(state_file)
    local out = fs.capture("timeout 3s hyprctl reload")
    if not (out and out:match("^%s*ok%s*$")) then
        fail("hyprctl reload failed while exiting Zen Mode")
    end
    if waybar_unit_loaded() then
        os.execute("systemctl --user reset-failed kaze-waybar.service >/dev/null 2>&1 || true")
        os.execute("systemctl --user start kaze-waybar.service >/dev/null 2>&1 || true")
    elseif waybar_running() and not waybar_mapped() then
        os.execute("pkill --signal USR1 -x --require-handler waybar >/dev/null 2>&1 || true")
    end
    notify("Restored desktop layout & effects")
end
