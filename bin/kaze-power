#!/usr/bin/env lua

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local direct_base = script:match("^(.*)/[^/]+$")
    local direct_lua = direct_base and (direct_base .. "/../lua") or nil
    local f_direct = direct_lua and io.open(direct_lua .. "/kaze/defaults.lua", "r") or nil
    if f_direct then
        f_direct:close()
        paths[#paths + 1] = direct_lua .. "/?.lua"
        paths[#paths + 1] = direct_lua .. "/?/init.lua"
    else
        local f_inst = io.open(xdg_data .. "/kaze-dots/lua/kaze/defaults.lua", "r")
        if f_inst then
            f_inst:close()
        else
            local q = "'" .. script:gsub("'", "'\\''") .. "'"
            local p = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
            local resolved = p and p:read("*l") or nil
            if p then
                p:close()
            end
            local base = (resolved or script):match("^(.*)/[^/]+$")
            if base then
                local repo_lua = base .. "/../lua"
                local f = io.open(repo_lua .. "/kaze/defaults.lua", "r")
                if f then
                    f:close()
                    paths[#paths + 1] = repo_lua .. "/?.lua"
                    paths[#paths + 1] = repo_lua .. "/?/init.lua"
                end
            end
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
end

setup_path()

local fs = require("kaze.fs")
local popups = require("kaze.popups")
local session = require("kaze.session")

local function cmd_exists(bin)
    local ok = os.execute("command -v " .. fs.shell_quote(bin) .. " >/dev/null 2>&1")
    return ok == true or ok == 0
end

if #arg > 0 then
    if #arg == 1 and (arg[1] == "-h" or arg[1] == "--help") then
        io.stdout:write("Usage: kaze-power\n")
        os.exit(0)
    end
    io.stderr:write(string.format("kaze-power: unknown option '%s'\n", tostring(arg[1])))
    os.exit(2)
end

if popups.toggle_existing_fuzzel("kaze-power") then
    os.exit(0)
end

if not cmd_exists("fuzzel") then
    io.stderr:write("kaze-power: fuzzel not found in PATH\n")
    os.exit(1)
end

local function logout()
    local ok, err = session.stop()
    if not ok then return nil, err end
    return os.execute("hyprctl dispatch 'hl.dsp.exit()'")
end

local items = {
    { label = "󰌾  Lock",       cmd = session.lock },
    { label = "󰍹  Screen Off", cmd = session.screen_off },
    { label = "󰍃  Logout",     cmd = logout },
    { label = "󰜉  Reboot",     cmd = "systemctl reboot" },
    { label = "󰐥  Shutdown",   cmd = "systemctl poweroff" },
}

local labels = {}
local actions = {}
for i, item in ipairs(items) do
    labels[i] = item.label
    actions[item.label] = item.cmd
end

local choice, dmenu_err = popups.run_dmenu(labels, {
    flags = popups.active_right_flags(),
    width = 28,
    lines = #labels,
    minimal_lines = true,
    hide_prompt = true,
    line_height = 34,
    prompt = "Power > ",
    tag = "kaze-power",
})
if not choice then
    io.stderr:write("kaze-power: " .. tostring(dmenu_err) .. "\n")
    os.exit(1)
end
if choice == "" then
    os.exit(0)
end

local action = actions[choice]
if not action then
    io.stderr:write(string.format("kaze-power: unrecognized selection '%s'\n", choice))
    os.exit(1)
end

local ok, err
if type(action) == "function" then
    ok, err = action()
else
    ok = os.execute(action)
end
if not ok then
    if err then
        io.stderr:write("kaze-power: " .. err .. "\n")
        os.execute("notify-send -t 3500 'Power action failed' " .. fs.shell_quote(err) .. " 2>/dev/null")
    end
    os.exit(1)
end
