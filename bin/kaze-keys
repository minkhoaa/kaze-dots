#!/usr/bin/env lua

if #arg > 0 then
    if #arg == 1 and (arg[1] == "-h" or arg[1] == "--help") then
        io.stdout:write("Usage: kaze-keys [--list]\n")
        os.exit(0)
    end
    if #arg > 1 or arg[1] ~= "--list" then
        io.stderr:write(string.format("kaze-keys: unknown option '%s'\nUsage: kaze-keys [--list]\n", tostring(arg[1])))
        os.exit(2)
    end
end

local script = (arg[0] or ""):gsub("'", "'\\''")
local link = io.popen("readlink -f -- '" .. script .. "' 2>/dev/null")
local resolved = link and link:read("*l")
if link then link:close() end
local repo = ((resolved or arg[0] or "."):match("^(.*)/[^/]+$") or ".") .. "/../lua"
local data = os.getenv("XDG_DATA_HOME") or ""
if data == "" then data = (os.getenv("HOME") or "") .. "/.local/share" end
local installed = data .. "/kaze-dots/lua"
package.path = table.concat({
    repo .. "/?.lua",
    repo .. "/?/init.lua",
    installed .. "/?.lua",
    installed .. "/?/init.lua",
    package.path,
}, ";")

local hypr_user = require("kaze.hypr_user")
local keybinds_data = require("kaze.keybinds_data")
local popups = require("kaze.popups")

local env_home = os.getenv("HOME")
local cfg = hypr_user.load({
    home = (not env_home or env_home == "") and "/" or nil,
})
local rows = keybinds_data.format_rows(cfg)

if arg[1] == "--list" then
    io.stdout:write(table.concat(rows, "\n") .. "\n")
    os.exit(0)
end

local _, dmenu_err = popups.run_dmenu(rows, {
    prompt = "Keys > ",
})
if dmenu_err then
    io.stderr:write("kaze-keys: " .. tostring(dmenu_err) .. "\n")
    os.exit(1)
end
os.exit(0)
