#!/usr/bin/env lua

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local direct_base = script:match("^(.*)/[^/]+$")
    local direct_lua = direct_base and (direct_base .. "/../lua") or nil
    local f_direct = direct_lua and io.open(direct_lua .. "/kaze/defaults.lua", "r") or nil
    if f_direct then
        f_direct:close()
        paths[#paths + 1] = direct_lua .. "/?.lua"
        paths[#paths + 1] = direct_lua .. "/?/init.lua"
    else
        local f_inst = io.open(xdg_data .. "/kaze-dots/lua/kaze/defaults.lua", "r")
        if f_inst then
            f_inst:close()
        else
            local q = "'" .. script:gsub("'", "'\\''") .. "'"
            local p = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
            local resolved = p and p:read("*l") or nil
            if p then p:close() end
            local base = (resolved or script):match("^(.*)/[^/]+$")
            if base then
                local repo_lua = base .. "/../lua"
                local f = io.open(repo_lua .. "/kaze/defaults.lua", "r")
                if f then
                    f:close()
                    paths[#paths + 1] = repo_lua .. "/?.lua"
                    paths[#paths + 1] = repo_lua .. "/?/init.lua"
                end
            end
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
end

setup_path()

local fs = require("kaze.fs")

local FORBIDDEN_KEYWORDS = {
    "function", "while", "repeat", "until", "for", "goto", "do", "end",
    "if", "then", "else", "elseif", "local", "return", "break",
}

local SAFE_ENV = setmetatable({
    abs = math.abs,
    acos = math.acos,
    asin = math.asin,
    atan = math.atan,
    ceil = math.ceil,
    cos = math.cos,
    deg = math.deg,
    e = math.exp(1),
    exp = math.exp,
    floor = math.floor,
    fmod = math.fmod,
    ln = math.log,
    log = math.log,
    log2 = function(x) return math.log(x, 2) end,
    log10 = function(x) return math.log(x, 10) end,
    max = math.max,
    min = math.min,
    pi = math.pi,
    rad = math.rad,
    round = function(x) return math.floor(x + 0.5) end,
    sin = math.sin,
    sqrt = math.sqrt,
    tan = math.tan,
    hex = function(x)
        local n = assert(tonumber(x), "hex() expects a number")
        return string.format("0x%x", math.floor(n))
    end,
}, {
    __newindex = function()
        error("assignment is not allowed", 0)
    end,
})

local function eval_expr(raw)
    if type(raw) ~= "string" then
        return nil, "invalid expression"
    end
    local expr = raw:gsub("^%s+", ""):gsub("%s+$", "")
    if expr == "" then
        return nil, "empty expression"
    end
    if #expr > 256 then
        return nil, "expression too long (max 256 chars)"
    end
    if expr:find("%.%.", 1, false) or expr:find("[\"'{}\\;%[%]]") then
        return nil, "disallowed syntax in calculator expression"
    end
    for _, kw in ipairs(FORBIDDEN_KEYWORDS) do
        if expr:find("%f[%a_]" .. kw .. "%f[^%a_]") then
            return nil, "disallowed keyword: " .. kw
        end
    end
    local chunk, syn_err = load("return (" .. expr .. ")", "=calc", "t", SAFE_ENV)
    if not chunk then
        return nil, syn_err or "syntax error"
    end
    local ok, res = pcall(chunk)
    if not ok then
        return nil, tostring(res)
    end
    local t = type(res)
    if t == "number" then
        if res ~= res or res == math.huge or res == -math.huge then
            return nil, "undefined result (NaN or infinity)"
        end
        if math.type(res) == "integer" then
            return tostring(res)
        end
        return string.format("%.10g", res)
    elseif t == "string" or t == "boolean" then
        return tostring(res)
    end
    return nil, "unsupported result type: " .. t
end

if #arg > 0 then
    if #arg == 1 and (arg[1] == "-h" or arg[1] == "--help") then
        io.stdout:write("Usage: kaze-calc [--eval EXPR]\n")
        os.exit(0)
    elseif #arg == 2 and arg[1] == "--eval" then
        local val, err = eval_expr(arg[2])
        if not val then
            io.stderr:write("kaze-calc: " .. tostring(err) .. "\n")
            os.exit(1)
        end
        io.stdout:write(val .. "\n")
        os.exit(0)
    else
        io.stderr:write("Usage: kaze-calc [--eval EXPR]\n")
        os.exit(2)
    end
end

local running = os.execute("pgrep -x fuzzel >/dev/null 2>&1")
if running == true or running == 0 then
    os.execute("pkill -x fuzzel >/dev/null 2>&1")
    os.exit(0)
end

if not fs.command_exists("fuzzel") then
    io.stderr:write("kaze-calc: fuzzel not found in PATH\n")
    os.exit(1)
end

local utf8_guard = "case \"${LC_ALL:-${LC_CTYPE:-${LANG:-C}}}\" in *.UTF-8*|*.utf8*) ;; *) export LC_CTYPE=C.UTF-8 ;; esac; "
local history = {}
local last_val = nil
local err_hint = nil

while true do
    local rows = {}
    if err_hint then
        rows[#rows + 1] = "! " .. err_hint
    elseif last_val then
        rows[#rows + 1] = "= " .. last_val .. "   (Enter to copy)"
    end
    for i = #history, 1, -1 do
        rows[#rows + 1] = history[i]
    end
    if #rows == 0 then
        rows[1] = "󰪚  Type math expression (e.g. 2^10, sqrt(144), hex(255))"
    end

    local cmd = string.format(
        "%sprintf '%%s\\n' %s | fuzzel --dmenu -w 50 --lines %d -p %s",
        utf8_guard,
        fs.shell_quote(table.concat(rows, "\n")),
        math.min(8, #rows),
        fs.shell_quote("Calc > ")
    )
    local p = io.popen(cmd)
    if not p then
        io.stderr:write("kaze-calc: failed to launch fuzzel\n")
        os.exit(1)
    end
    local out = p:read("*a") or ""
    p:close()

    local input = out:gsub("[\r\n]+$", "")
    if input == "" or input:sub(1, 3) == "󰪚" then
        os.exit(0)
    end

    local copy_target = input:match("^=%s*(%S+)%s+%(Enter to copy%)$")
        or input:match("^.-%s+=%s+(%S+)$")
    if copy_target then
        if fs.command_exists("wl-copy") then
            os.execute("printf '%s' " .. fs.shell_quote(copy_target) .. " | wl-copy --type text/plain >/dev/null 2>&1")
        end
        if fs.command_exists("notify-send") then
            os.execute(string.format(
                "notify-send -a kaze-calc -t 1500 -u low -h string:x-canonical-private-synchronous:kaze-switch %s %s >/dev/null 2>&1 || true",
                fs.shell_quote("Calculator"),
                fs.shell_quote("Copied " .. copy_target)
            ))
        end
        os.exit(0)
    end

    if input:sub(1, 2) ~= "! " then
        local val, err = eval_expr(input)
        if val then
            err_hint = nil
            last_val = val
            history[#history + 1] = input .. " = " .. val
            rawset(SAFE_ENV, "ans", tonumber(val) or last_val)
        else
            err_hint = err
        end
    else
        os.exit(0)
    end
end
