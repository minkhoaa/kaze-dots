#!/usr/bin/env lua

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local q = "'" .. script:gsub("'", "'\\''") .. "'"
    local p = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
    local resolved = p and p:read("*l") or nil
    if p then
        p:close()
    end
    local base = (resolved or script):match("^(.*)/[^/]+$")
    if base then
        local repo_lua = base .. "/../lua"
        local f = io.open(repo_lua .. "/kaze/fs.lua", "r")
        if f then
            f:close()
            paths[#paths + 1] = repo_lua .. "/?.lua"
            paths[#paths + 1] = repo_lua .. "/?/init.lua"
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
    return resolved or script
end

local SELF_PATH = setup_path()

local display = require("kaze.display")
local fs = require("kaze.fs")
local hypr_user = require("kaze.hypr_user")
local json = require("kaze.json")
local popups = require("kaze.popups")
local ok_styles, styles = pcall(require, "kaze.styles")

local function usage(out)
    out:write([[Usage: kaze-display [COMMAND]

Commands:
  --menu                     Open interactive display / presentation menu (default)
  --hotplug <monitor>        Handle external monitor plug event safely
  --on-disconnect <monitor>  Recover internal display & clean state on unplug
  --list                     Print connected monitors
  extend-right               Extend primary monitor to the right
  extend-left                Extend primary monitor to the left
  extend-up                  Extend external monitor above primary
  mirror                     Native Hyprland mirror
  mirror-scaled              Extend + fullscreen wl-mirror on external monitor
  stop-mirror                Stop mirror and return to extended layout
  external [--no-confirm]    External monitor only (15s auto-revert unless --no-confirm)
  internal                   Laptop monitor only (disable external screen)
  auto                       Reset physical monitors to auto
  present [ws_id]            Present workspace on external monitor (hides bar, sets DND)
  toggle-control             Control presented HDMI workspace or kaze-share on laptop
  toggle-virtual-control     Control kaze-share directly (fullscreen wl-mirror + focus)
  stop-present               Stop presentation and restore bar/DND
  virtual-share [ws_id]      Create 1080p kaze-share headless output at 9999x0
  switch-share [ws_id]       Switch workspace shown on kaze-share
  toggle-preview             Toggle floating wl-mirror preview of kaze-share / present
  toggle-window-share        Push/pull focused window to/from shared workspace
  stop-virtual               Move windows back and remove kaze-share
  cleanup                    Full safe teardown on session logout
  -h, --help                 Show this help message
]])
end

local function cmd_exists(bin)
    local ok = os.execute("command -v " .. fs.shell_quote(bin) .. " >/dev/null 2>&1")
    return ok == true or ok == 0
end

local function notify(title, body, urgency)
    if not cmd_exists("notify-send") then
        return
    end
    os.execute(string.format(
        "notify-send -a kaze-display -t 2400 -u %s -h string:x-canonical-private-synchronous:kaze-display %s %s >/dev/null 2>&1 || true",
        fs.shell_quote(urgency or "low"),
        fs.shell_quote(title),
        fs.shell_quote(body)
    ))
end

local function state_file_path()
    local rdir = fs.private_runtime_dir()
    if not rdir then
        return nil
    end
    return rdir .. "/display-state.json"
end

local function monitors_lua_path()
    local rdir = fs.private_runtime_dir()
    if not rdir then
        return nil
    end
    return rdir .. "/monitors.lua"
end

local function menu_lock_path()
    local rdir = fs.private_runtime_dir()
    if not rdir then
        return nil
    end
    return rdir .. "/display-menu.lock"
end

local function mutation_lock_path()
    local rdir = fs.private_runtime_dir()
    if not rdir then
        return nil
    end
    return rdir .. "/display.lock"
end

local function revert_file_path()
    local rdir = fs.private_runtime_dir()
    if not rdir then
        return nil
    end
    return rdir .. "/external-revert.json"
end

local function run_locked_subcmd(lock_path, wait_secs, env_var, argv, capture_stdout)
    if not lock_path or not fs.command_exists("flock") then
        return nil, nil
    end
    local q = fs.shell_quote
    local flock_mode = wait_secs and ("-w " .. tostring(wait_secs)) or "-n"
    local parts = {
        "umask 077; exec flock",
        flock_mode,
        "--close",
        "-E 75",
        q(lock_path),
        "/usr/bin/env",
        env_var .. "=1",
        q(SELF_PATH),
    }
    for _, a in ipairs(argv or {}) do
        parts[#parts + 1] = q(a)
    end
    local cmdline = table.concat(parts, " ")
    if capture_stdout then
        local proc = io.popen(cmdline, "r")
        if not proc then
            return 1, ""
        end
        local out = proc:read("*a") or ""
        local ok, why, code = proc:close()
        return fs.exit_status(ok, why, code), out
    end
    local ok, why, code = os.execute(cmdline)
    return fs.exit_status(ok, why, code), nil
end

local function save_runtime_monitors(cmds, state)
    local path = monitors_lua_path()
    if not path then return end
    local lines = {}
    local has_share = false
    for _, expr in ipairs(cmds or {}) do
        lines[#lines + 1] = expr
        if expr:find('output = "kaze-share"', 1, true) then
            has_share = true
        end
    end
    if type(state) == "table" and state.virtual_monitor == "kaze-share" and not has_share then
        lines[#lines + 1] = 'hl.monitor({ output = "kaze-share", mode = "1920x1080@60", position = "9999x0", scale = 1, disabled = false, mirror = "" })'
    end
    if #lines == 0 then
        os.remove(path)
        return
    end
    pcall(fs.write_atomic, path, table.concat(lines, "\n") .. "\n")
end

local function clear_runtime_monitors(keep_virtual_share)
    local path = monitors_lua_path()
    if not path then return end
    if keep_virtual_share then
        pcall(fs.write_atomic, path, 'hl.monitor({ output = "kaze-share", mode = "1920x1080@60", position = "9999x0", scale = 1, disabled = false, mirror = "" })\n')
    else
        os.remove(path)
    end
end

local function strip_virtual_share_runtime_monitor()
    local path = monitors_lua_path()
    if not path then return end
    local raw = fs.read_file(path)
    if not raw then return end
    local kept = {}
    for line in raw:gmatch("[^\n]+") do
        if not line:find('output = "kaze-share"', 1, true) then
            kept[#kept + 1] = line
        end
    end
    if #kept == 0 then
        os.remove(path)
    else
        pcall(fs.write_atomic, path, table.concat(kept, "\n") .. "\n")
    end
end

local function load_state()
    local path = state_file_path()
    if not path then return {} end
    local raw = fs.read_file(path)
    if not raw or not raw:find("%S") then return {} end
    local ok, tbl = pcall(json.decode, raw)
    if ok and type(tbl) == "table" then
        return tbl
    end
    return {}
end

local function is_persistent_workspace_id(ws_id, cfg)
    local n = tonumber(ws_id)
    if not n or n < 1 or math.floor(n) ~= n then
        return false
    end
    local persist_count = tonumber(cfg and cfg.persistent_workspaces)
    if persist_count == nil then
        persist_count = 5
    end
    return n <= math.floor(persist_count)
end

local function format_edge_rule_lines(ws_id, rule_name, target_mon, cfg)
    if ws_id == nil or tostring(ws_id) == "" then return {} end
    local ws_str = tostring(ws_id)
    local persist_part = is_persistent_workspace_id(ws_id, cfg) and ", persistent = true" or ""
    local lines = {}
    if type(target_mon) == "string" and target_mon ~= "" then
        lines[#lines + 1] = string.format(
            "do local r = hl.workspace_rule({ workspace = %q, monitor = %q, gaps_out = 0, gaps_in = 0%s }); if r and r.set_enabled then r:set_enabled(true) end end",
            ws_str, target_mon, persist_part
        )
    else
        lines[#lines + 1] = string.format(
            "do local r = hl.workspace_rule({ workspace = %q, gaps_out = 0, gaps_in = 0%s }); if r and r.set_enabled then r:set_enabled(true) end end",
            ws_str, persist_part
        )
    end
    lines[#lines + 1] = string.format(
        "hl.window_rule({ name = %q, match = { workspace = %q }, border_size = 0, rounding = 0, enabled = true })",
        rule_name, ws_str
    )
    return lines
end

local function sync_runtime_edge_rules(state)
    local path = monitors_lua_path()
    if not path then return end
    local raw = fs.read_file(path) or ""
    local kept = {}
    for line in raw:gmatch("[^\n]+") do
        if line:find("^hl%.monitor%(") then
            kept[#kept + 1] = line
        end
    end
    if type(state) == "table" then
        local cfg = hypr_user.load()
        if state.mode == "present" and not state.control_on_laptop and state.present_workspace and state.external_monitor then
            for _, l in ipairs(format_edge_rule_lines(state.present_workspace, "kaze-present-edge", state.external_monitor, cfg)) do
                kept[#kept + 1] = l
            end
        end
        if state.virtual_monitor == "kaze-share" and state.virtual_workspace then
            for _, l in ipairs(format_edge_rule_lines(state.virtual_workspace, "kaze-share-edge", "kaze-share", cfg)) do
                kept[#kept + 1] = l
            end
        end
    end
    if #kept == 0 then
        os.remove(path)
    else
        pcall(fs.write_atomic, path, table.concat(kept, "\n") .. "\n")
    end
end

local function save_state(state)
    local path = state_file_path()
    if not path then return end
    state.generation = (tonumber(state.generation) or 0) + 1
    pcall(fs.write_atomic, path, json.encode(state))
    sync_runtime_edge_rules(state)
end

local function clear_state()
    local path = state_file_path()
    if path then
        os.remove(path)
    end
    local rpath = revert_file_path()
    if rpath then
        os.remove(rpath)
    end
    clear_runtime_monitors(false)
end

local function hypr_eval(expr)
    local ok = os.execute("hyprctl eval " .. fs.shell_quote(expr) .. " >/dev/null 2>&1")
    return ok == true or ok == 0
end

local function disable_window_rule(rule_name)
    if type(rule_name) ~= "string" or rule_name == "" then
        return
    end
    hypr_eval(string.format("hl.window_rule({ name = %q, enabled = false })", rule_name))
end

local function set_edge_to_edge_workspace(ws_id, rule_name, target_mon)
    if ws_id == nil or tostring(ws_id) == "" then return end
    local cfg = hypr_user.load()
    local ws_str = tostring(ws_id)
    local persist_part = is_persistent_workspace_id(ws_id, cfg) and ", persistent = true" or ""
    if type(target_mon) == "string" and target_mon ~= "" then
        hypr_eval(string.format(
            "local r = hl.workspace_rule({ workspace = %q, monitor = %q, gaps_out = 0, gaps_in = 0%s }); if r and r.set_enabled then r:set_enabled(true) end",
            ws_str, target_mon, persist_part
        ))
    else
        hypr_eval(string.format(
            "local r = hl.workspace_rule({ workspace = %q, gaps_out = 0, gaps_in = 0%s }); if r and r.set_enabled then r:set_enabled(true) end",
            ws_str, persist_part
        ))
    end
    hypr_eval(string.format(
        'hl.window_rule({ name = %q, match = { workspace = %q }, border_size = 0, rounding = 0, enabled = true })',
        rule_name, ws_str
    ))
end

-- Disables the temporary per-workspace rule via :set_enabled(false) so smart_gaps (w[tv1])
-- is never overridden and the workspace is never permanently pinned to a single monitor,
-- while re-preserving persistent = true for workspaces 1..persistent_workspaces.
local function restore_workspace_edges(ws_id, rule_name)
    if ws_id == nil or tostring(ws_id) == "" then return end
    local cfg = hypr_user.load()
    local ws_str = tostring(ws_id)
    if is_persistent_workspace_id(ws_id, cfg) then
        hypr_eval(string.format(
            "local r = hl.workspace_rule({ workspace = %q }); if r and r.set_enabled then r:set_enabled(false) end; hl.workspace_rule({ workspace = %q, persistent = true })",
            ws_str, ws_str
        ))
    else
        hypr_eval(string.format(
            "local r = hl.workspace_rule({ workspace = %q }); if r and r.set_enabled then r:set_enabled(false) end",
            ws_str
        ))
    end
    disable_window_rule(rule_name)
end

local function get_monitors()
    local raw = fs.capture("hyprctl -j monitors all 2>/dev/null")
    return display.parse_monitors(raw or "")
end

local function get_workspaces_and_clients()
    local ws_raw = fs.capture("hyprctl -j workspaces 2>/dev/null") or "[]"
    local clients_raw = fs.capture("hyprctl -j clients 2>/dev/null") or "[]"
    return display.parse_workspaces(ws_raw, clients_raw), ws_raw, clients_raw
end

local function build_occupied_workspaces(workspaces, extra_ids)
    local occupied = {}
    for _, w in ipairs(workspaces or {}) do
        occupied[#occupied + 1] = w
    end
    if type(extra_ids) == "table" then
        for _, id in pairs(extra_ids) do
            local n = tonumber(id)
            if n and n > 0 then
                occupied[#occupied + 1] = { id = n }
            end
        end
    end
    return occupied
end

local function find_monitor_by_name(monitors, name)
    for _, m in ipairs(monitors or {}) do
        if m.name == name then
            return m
        end
    end
    return nil
end

local function move_workspace_to_monitor(ws_id, target_mon, primary_mon, existing_workspaces)
    local ws_str = tostring(ws_id)
    local exists = false
    for _, w in ipairs(existing_workspaces or {}) do
        if w.id == tonumber(ws_id) then
            exists = true
            break
        end
    end
    if exists then
        hypr_eval(string.format("hl.dispatch(hl.dsp.workspace.move({ workspace = %q, monitor = %q }))", ws_str, target_mon))
    end
    local primary_name = primary_mon and primary_mon.name or target_mon
    hypr_eval(string.format(
        "hl.dispatch(hl.dsp.focus({ monitor = %q })); hl.dispatch(hl.dsp.focus({ workspace = %q })); hl.dispatch(hl.dsp.focus({ monitor = %q }))",
        target_mon, ws_str, primary_name
    ))
end

local function evacuate_workspace_to_primary(ws_id, rule_name, from_mon_name, primary_mon, existing_workspaces)
    if ws_id == nil or tostring(ws_id) == "" then return end
    restore_workspace_edges(ws_id, rule_name)
    if not primary_mon or not primary_mon.name or primary_mon.name == "" then
        return
    end
    local ws_num = tonumber(ws_id)
    local ws_str = tostring(ws_id)
    local wss = existing_workspaces or get_workspaces_and_clients()
    for _, w in ipairs(wss) do
        if w.id == ws_num and (from_mon_name == nil or w.monitor == from_mon_name) and w.monitor ~= primary_mon.name then
            hypr_eval(string.format(
                "hl.dispatch(hl.dsp.workspace.move({ workspace = %q, monitor = %q }))",
                ws_str, primary_mon.name
            ))
            break
        end
    end
end

local function ensure_dpms_awake(mon_list)
    for _, m in ipairs(mon_list or {}) do
        if not m.virtual and not m.disabled and m.dpms == false then
            hypr_eval('hl.dispatch(hl.dsp.dpms({ action = "on" }))')
            return
        end
    end
end

local function wait_for_monitor_awake(mon_name, max_polls)
    if type(mon_name) ~= "string" or mon_name == "" then
        return false
    end
    for _ = 1, (max_polls or 6) do
        os.execute("sleep 0.1")
        local m = find_monitor_by_name(get_monitors(), mon_name)
        if m and not m.disabled then
            return true
        end
    end
    return false
end

local function wait_for_window_title(title, max_polls)
    if type(title) ~= "string" or title == "" then
        return false
    end
    for _ = 1, (max_polls or 12) do
        local raw = fs.capture("hyprctl -j clients 2>/dev/null") or "[]"
        local ok, clients = pcall(json.decode, raw)
        if ok and type(clients) == "table" then
            for _, c in ipairs(clients) do
                if type(c) == "table" and (c.title == title or c.initialTitle == title) then
                    return true
                end
            end
        end
        os.execute("sleep 0.05")
    end
    return false
end

local function active_bar_names()
    if ok_styles and type(styles) == "table" and type(styles.bar_names) == "function" then
        local cur = styles.current_style()
        local names = styles.bar_names(cur)
        if type(names) == "table" and #names > 0 then
            return names
        end
    end
    return { "default" }
end

local function toml_quote(s)
    return '"' .. tostring(s):gsub("\\", "\\\\"):gsub('"', '\\"') .. '"'
end

local function sync_present_indicator(mode, detail)
    if not cmd_exists("noctalia") then
        return
    end
    local wtype = fs.capture("noctalia msg config-get widget.present.type 2>/dev/null")
    if not wtype then
        return
    end
    wtype = wtype:gsub("^%s+", ""):gsub("%s+$", ""):gsub("^['\"]", ""):gsub("['\"]$", "")
    if wtype ~= "custom_button" then
        return
    end
    local q = fs.shell_quote
    local enabled, glyph, color, label, tooltip
    if mode == "present" then
        enabled = "true"
        glyph = "presentation"
        color = "primary"
        label = "LIVE"
        tooltip = "Presenting" .. (detail and detail ~= "" and (" (" .. detail .. ")") or "") .. " — click for Display Menu"
    elseif mode == "virtual-control" then
        enabled = "true"
        glyph = "cast"
        color = "primary"
        label = "CTRL"
        tooltip = "Controlling kaze-share directly" .. (detail and detail ~= "" and (" (" .. detail .. ")") or "") .. " — Ctrl+Super+P to return"
    elseif mode == "virtual-share" then
        enabled = "true"
        glyph = "cast"
        color = "secondary"
        label = "SHARE"
        tooltip = "Virtual Share active" .. (detail and detail ~= "" and (" (" .. detail .. ")") or "") .. " — click for Display Menu"
    else
        enabled = "false"
        glyph = "presentation"
        color = "on_surface_variant"
        label = ""
        tooltip = "Display Share Inactive"
    end
    os.execute("noctalia msg config-set widget.present.enabled " .. enabled .. " >/dev/null 2>&1 || true")
    os.execute("noctalia msg config-set widget.present.glyph " .. q(toml_quote(glyph)) .. " >/dev/null 2>&1 || true")
    os.execute("noctalia msg config-set widget.present.icon_color " .. q(toml_quote(color)) .. " >/dev/null 2>&1 || true")
    os.execute("noctalia msg config-set widget.present.label " .. q(toml_quote(label)) .. " >/dev/null 2>&1 || true")
    os.execute("noctalia msg config-set widget.present.tooltip " .. q(toml_quote(tooltip)) .. " >/dev/null 2>&1 || true")
end

local function refresh_present_indicator(state)
    if type(state) ~= "table" then
        sync_present_indicator(nil)
        return
    end
    if state.control_virtual == true then
        local detail = state.virtual_workspace and ("WS " .. tostring(state.virtual_workspace)) or "kaze-share"
        sync_present_indicator("virtual-control", detail)
    elseif state.mode == "present" or state.present_workspace ~= nil then
        local detail = state.present_workspace and ("WS " .. tostring(state.present_workspace)) or ""
        sync_present_indicator("present", detail)
    elseif state.virtual_monitor == "kaze-share" or state.mode == "virtual-share" then
        local detail = state.virtual_workspace and ("WS " .. tostring(state.virtual_workspace)) or "kaze-share"
        sync_present_indicator("virtual-share", detail)
    else
        sync_present_indicator(nil)
    end
end

local function reapply_virtual_share_after_reload(state, primary_mon)
    if type(state) ~= "table" or state.virtual_monitor ~= "kaze-share" then
        return
    end
    hypr_eval('hl.monitor({ output = "kaze-share", mode = "1920x1080@60", position = "9999x0", scale = 1, disabled = false, mirror = "" })')
    if cmd_exists("noctalia") then
        for _, bar_name in ipairs(active_bar_names()) do
            os.execute("noctalia msg bar-hide " .. fs.shell_quote(bar_name) .. " kaze-share >/dev/null 2>&1 || true")
        end
    end
    if state.virtual_workspace then
        set_edge_to_edge_workspace(state.virtual_workspace, "kaze-share-edge", "kaze-share")
        local existing_ws = get_workspaces_and_clients()
        move_workspace_to_monitor(state.virtual_workspace, "kaze-share", primary_mon, existing_ws)
    end
end

local function apply_plan(plan, state, primary_mon, persist_mode, cur_monitors)
    if persist_mode == "auto" then
        clear_runtime_monitors(type(state) == "table" and state.virtual_monitor == "kaze-share")
    else
        save_runtime_monitors(plan.eval_cmds, state)
    end
    ensure_dpms_awake(cur_monitors)
    if plan.needs_reload then
        os.execute("hyprctl reload >/dev/null 2>&1")
        os.execute("sleep 0.15")
    end
    for _, expr in ipairs(plan.eval_cmds or {}) do
        if not hypr_eval(expr) then
            io.stderr:write("kaze-display: failed evaluating Hyprland rule: " .. expr .. "\n")
            notify("Display switch failed", expr, "critical")
            return false
        end
    end
    if plan.needs_reload then
        os.execute("sleep 0.25")
        reapply_virtual_share_after_reload(state, primary_mon)
    end
    return true
end

local function is_pid_running(pid, expected_comm)
    local n = tonumber(pid)
    if not n or n <= 0 or math.floor(n) ~= n then
        return false
    end
    local comm = fs.read_file(string.format("/proc/%d/comm", n))
    if not comm then
        return false
    end
    return comm:gsub("%s+$", "") == expected_comm
end

local function stop_verified_pid(pid, expected_comm)
    if not is_pid_running(pid, expected_comm) then
        return false
    end
    os.execute(string.format("kill -TERM %d >/dev/null 2>&1 || true", tonumber(pid)))
    return true
end

local function spawn_wl_mirror(args)
    if not cmd_exists("wl-mirror") then
        return nil, "wl-mirror not found in PATH"
    end
    local parts = { "nohup", "wl-mirror" }
    for _, a in ipairs(args) do
        parts[#parts + 1] = fs.shell_quote(a)
    end
    local cmd = table.concat(parts, " ") .. " </dev/null >/dev/null 2>&1 & printf '%d\\n' \"$!\""
    local out = fs.capture(cmd)
    local pid = out and tonumber(out:match("^(%d+)")) or nil
    if not pid or pid <= 0 then
        return nil, "failed to start wl-mirror"
    end
    return pid
end

local function noctalia_dnd_status()
    if not cmd_exists("noctalia") then
        return nil
    end
    local out = fs.capture("noctalia msg notification-dnd-status 2>/dev/null")
    if not out then return nil end
    local trimmed = out:gsub("^%s+", ""):gsub("%s+$", "")
    if trimmed == "on" or trimmed == "off" then
        return trimmed
    end
    return nil
end

local function enable_managed_dnd(state)
    if not cmd_exists("noctalia") then
        return
    end
    if not state.dnd_managed then
        local cur = noctalia_dnd_status()
        state.dnd_managed = true
        state.dnd_was_active = (cur == "on")
        if not state.dnd_was_active then
            os.execute("noctalia msg notification-dnd-set on >/dev/null 2>&1 || true")
        end
    end
end

local function restore_dnd_if_managed(state)
    if display.should_restore_dnd(state) and cmd_exists("noctalia") then
        os.execute("noctalia msg notification-dnd-set off >/dev/null 2>&1 || true")
    end
    state.dnd_managed = nil
    state.dnd_was_active = nil
end

local function hide_bar_on(state, monitor_name)
    if not cmd_exists("noctalia") or type(monitor_name) ~= "string" or monitor_name == "" then
        return
    end
    for _, bar_name in ipairs(active_bar_names()) do
        os.execute("noctalia msg bar-hide " .. fs.shell_quote(bar_name) .. " " .. fs.shell_quote(monitor_name) .. " >/dev/null 2>&1 || true")
    end
    state.bar_hidden_monitors = type(state.bar_hidden_monitors) == "table" and state.bar_hidden_monitors or {}
    for _, m in ipairs(state.bar_hidden_monitors) do
        if m == monitor_name then
            return
        end
    end
    state.bar_hidden_monitors[#state.bar_hidden_monitors + 1] = monitor_name
end

local function restore_bars(state)
    if cmd_exists("noctalia") and type(state.bar_hidden_monitors) == "table" then
        for _, m in ipairs(state.bar_hidden_monitors) do
            if type(m) == "string" and m ~= "" then
                for _, bar_name in ipairs(active_bar_names()) do
                    os.execute("noctalia msg bar-show " .. fs.shell_quote(bar_name) .. " " .. fs.shell_quote(m) .. " >/dev/null 2>&1 || true")
                end
            end
        end
    end
    state.bar_hidden_monitors = nil
end

local function has_lock_layer(tbl)
    if type(tbl) ~= "table" then return false end
    if type(tbl.namespace) == "string" then
        local ns = tbl.namespace:lower()
        if (ns:find("noctalia") and ns:find("lock")) or ns == "lockscreen" then
            return true
        end
    end
    for _, v in pairs(tbl) do
        if type(v) == "table" and has_lock_layer(v) then
            return true
        end
    end
    return false
end

local function is_screen_locked()
    if cmd_exists("hyprctl") then
        local locked_raw = fs.capture("hyprctl -j locked 2>/dev/null")
        if locked_raw and locked_raw:find("%S") then
            local ok, obj = pcall(json.decode, locked_raw)
            if ok and type(obj) == "table" and obj.locked == true then
                return true
            end
        end
    end
    if cmd_exists("loginctl") then
        local sid = os.getenv("XDG_SESSION_ID")
        if not sid or not sid:match("^[%w_-]+$") then
            local disp = fs.capture('loginctl show-user "$(id -u)" -p Display --value 2>/dev/null')
            sid = disp and disp:match("^([%w_-]+)") or nil
        end
        if sid and sid ~= "" then
            local locked = fs.capture("loginctl show-session " .. fs.shell_quote(sid) .. " -p LockedHint --value 2>/dev/null")
            if locked and locked:gsub("%s+$", "") == "yes" then
                return true
            end
        end
    end
    if cmd_exists("hyprctl") then
        local layers_raw = fs.capture("hyprctl -j layers 2>/dev/null")
        if layers_raw and layers_raw:find("%S") then
            local ok, layers = pcall(json.decode, layers_raw)
            if ok and has_lock_layer(layers) then
                return true
            end
        end
    end
    return false
end

local function pick_workspace_via_dmenu(prompt_text, current_ws_id, extra_reserved_ids)
    local workspaces = get_workspaces_and_clients()
    local ordered = display.order_workspaces_for_picker(workspaces, current_ws_id)
    local occupied = build_occupied_workspaces(workspaces, extra_reserved_ids)
    local clean_id = display.pick_clean_workspace_id(occupied)
    local entries = {}
    for _, w in ipairs(ordered) do
        entries[#entries + 1] = {
            label = display.format_workspace_entry(w, current_ws_id),
            ws_id = w.id,
        }
    end
    entries[#entries + 1] = {
        label = string.format("󰐕  New clean workspace (WS %d)", clean_id),
        ws_id = clean_id,
    }
    local labels = {}
    local by_label = {}
    for _, e in ipairs(entries) do
        labels[#labels + 1] = e.label
        by_label[e.label] = e.ws_id
    end
    local choice, err = popups.run_dmenu(labels, { prompt = prompt_text or "Workspace > " })
    if not choice then
        return nil, nil, err
    end
    if choice == "" then
        return "", workspaces, nil
    end
    local selected = by_label[choice]
    if not selected then
        return nil, nil, "unrecognized workspace selection '" .. choice .. "'"
    end
    return selected, workspaces, nil
end

local function stop_virtual_control(state, primary_mon, restore_preview)
    local was_active = (state.control_virtual == true) or (state.control_pid ~= nil)
    if state.control_pid then
        stop_verified_pid(state.control_pid, "wl-mirror")
        state.control_pid = nil
    end
    state.control_virtual = nil
    local saved_ws = state.saved_virtual_laptop_workspace
    state.saved_virtual_laptop_workspace = nil
    local suspended_preview = (state.virtual_preview_suspended == true)
    state.virtual_preview_suspended = nil

    if was_active and primary_mon and primary_mon.name and primary_mon.name ~= "" then
        if saved_ws then
            hypr_eval(string.format(
                "hl.dispatch(hl.dsp.focus({ monitor = %q })); hl.dispatch(hl.dsp.focus({ workspace = %q }))",
                primary_mon.name, tostring(saved_ws)
            ))
        else
            hypr_eval(string.format("hl.dispatch(hl.dsp.focus({ monitor = %q }))", primary_mon.name))
        end
    end

    if restore_preview and suspended_preview and cmd_exists("wl-mirror") then
        local pid = spawn_wl_mirror({ "--title", "kaze-share-preview", "kaze-share" })
        if pid then
            state.preview_pid = pid
            state.preview_target = "kaze-share"
        end
    end
    return was_active
end

local function cleanup_virtual_share(monitors, state)
    if state.control_pid then
        stop_verified_pid(state.control_pid, "wl-mirror")
        state.control_pid = nil
    end
    state.control_virtual = nil
    state.saved_virtual_laptop_workspace = nil
    state.virtual_preview_suspended = nil

    if state.preview_pid and state.preview_target == "kaze-share" then
        stop_verified_pid(state.preview_pid, "wl-mirror")
        state.preview_pid = nil
        state.preview_target = nil
    elseif state.preview_pid and not state.preview_target then
        stop_verified_pid(state.preview_pid, "wl-mirror")
        state.preview_pid = nil
    end

    local internal, externals = display.pick_roles(monitors)
    local primary = display.pick_primary_enabled(internal, externals)

    if state.virtual_workspace then
        restore_workspace_edges(state.virtual_workspace, "kaze-share-edge")
    end

    local share_mon = find_monitor_by_name(monitors, "kaze-share")
    if share_mon or state.virtual_monitor == "kaze-share" then
        local primary_ws = (primary and primary.active_workspace) or 1
        local target_ws = tonumber(state.virtual_workspace) or -1
        hypr_eval(string.format([[
for _, w in ipairs(hl.get_windows()) do
    local on_mon = w.monitor and w.monitor.name == "kaze-share"
    local on_ws = w.workspace and w.workspace.id == %d
    if on_mon or on_ws then
        hl.dispatch(hl.dsp.window.move({ workspace = %q, window = w, silent = true }))
    end
end
]], target_ws, tostring(primary_ws)))

        local workspaces = get_workspaces_and_clients()
        if primary then
            for _, w in ipairs(workspaces) do
                if w.monitor == "kaze-share" or (state.virtual_workspace and w.id == tonumber(state.virtual_workspace)) then
                    hypr_eval(string.format(
                        "hl.dispatch(hl.dsp.workspace.move({ workspace = %q, monitor = %q }))",
                        tostring(w.id),
                        primary.name
                    ))
                end
            end
            hypr_eval(string.format("hl.dispatch(hl.dsp.focus({ monitor = %q }))", primary.name))
        end

        if share_mon then
            os.execute("hyprctl output remove kaze-share >/dev/null 2>&1")
        end
    end

    state.virtual_monitor = nil
    state.virtual_workspace = nil
    if state.mode == "virtual-share" then
        state.mode = nil
    end
    strip_virtual_share_runtime_monitor()
end

-- Parse CLI args
local cmd = nil
local sub_arg = nil
local target_override = nil
local no_confirm = false
local pick_only = false
local stage_external = false
local confirm_external = false
local revert_external = false
local confirm_args = {}
do
    local i = 1
    while i <= #arg do
        local a = arg[i]
        if a == "-h" or a == "--help" then
            usage(io.stdout)
            os.exit(0)
        elseif a == "--no-confirm" then
            no_confirm = true
        elseif a == "--pick-only" then
            pick_only = true
        elseif a == "--stage-external" then
            stage_external = true
        elseif a == "--confirm-external" then
            confirm_external = true
            confirm_args = { arg[i + 1], arg[i + 2], arg[i + 3] }
            i = i + 3
        elseif a == "--revert-external" then
            revert_external = true
            confirm_args = { arg[i + 1], arg[i + 2] }
            i = i + 2
        elseif a == "--target" then
            i = i + 1
            target_override = arg[i]
            if not target_override or target_override == "" then
                io.stderr:write("kaze-display: --target requires a monitor name\n")
                os.exit(2)
            end
        elseif a:sub(1, 9) == "--target=" then
            target_override = a:sub(10)
            if target_override == "" then
                io.stderr:write("kaze-display: --target requires a monitor name\n")
                os.exit(2)
            end
        elseif a == "--hotplug" or a == "--on-disconnect" then
            if cmd then
                io.stderr:write("kaze-display: too many arguments\n")
                usage(io.stderr)
                os.exit(2)
            end
            cmd = a
            i = i + 1
            sub_arg = arg[i]
            if not sub_arg or sub_arg == "" then
                io.stderr:write(string.format("kaze-display: %s requires a monitor name\n", a))
                os.exit(2)
            end
        elseif a:sub(1, 10) == "--hotplug=" then
            cmd = "--hotplug"
            sub_arg = a:sub(11)
        elseif a:sub(1, 16) == "--on-disconnect=" then
            cmd = "--on-disconnect"
            sub_arg = a:sub(17)
        elseif not cmd then
            cmd = a
        elseif not sub_arg and (cmd == "present" or cmd == "virtual-share" or cmd == "switch-share") then
            sub_arg = a
        else
            io.stderr:write("kaze-display: too many arguments\n")
            usage(io.stderr)
            os.exit(2)
        end
        i = i + 1
    end
    if not confirm_external and not revert_external then
        cmd = cmd or "--menu"
    end
end

local function is_interactive_pick(c, a)
    if c == "--menu" or c == "virtual-share-pick" then
        return true
    end
    if (c == "present" or c == "switch-share") and (a == nil or a == "") then
        return true
    end
    return false
end

local function run_external_confirm_dialog(ext_name, internal_name)
    local timeout_sec = tonumber(os.getenv("KAZE_DISPLAY_CONFIRM_SEC")) or 15
    if not timeout_sec or timeout_sec <= 0 then
        timeout_sec = 15
    end
    -- Give Noctalia a brief moment to re-anchor layer-shell onto the external monitor
    -- after disabling the internal display so the confirmation prompt renders cleanly.
    if timeout_sec >= 1 then
        os.execute("sleep 0.25")
    end
    local revert_label = string.format("󰌢  Revert to Laptop (%s)", internal_name or "laptop")
    local keep_label = string.format("󰄬  Keep External Only (%s)", ext_name or "external")
    local prompt = string.format("Keep External Only (%s)? Auto-revert %ds > ", ext_name or "external", math.ceil(timeout_sec))
    local choice, _, timed_out = popups.run_dmenu({ revert_label, keep_label }, {
        prompt = prompt,
        timeout = timeout_sec,
    })
    if choice == keep_label then
        return "keep"
    end
    if timed_out then
        return "timeout"
    end
    return "revert"
end

-- Internal confirmation prompt stage (runs strictly under display-menu.lock, never holding display.lock)
if confirm_external then
    if os.getenv("KAZE_DISPLAY_MENU_LOCKED") ~= "1" then
        local st, out = run_locked_subcmd(menu_lock_path(), nil, "KAZE_DISPLAY_MENU_LOCKED", {
            "--confirm-external",
            tostring(confirm_args[1] or ""),
            tostring(confirm_args[2] or "external"),
            tostring(confirm_args[3] or "laptop"),
        }, true)
        if st == 75 then
            io.stdout:write("revert\n")
            os.exit(0)
        elseif st ~= nil then
            io.stdout:write(out or "")
            os.exit(st)
        end
    end
    io.stdout:write(run_external_confirm_dialog(confirm_args[2], confirm_args[3]) .. "\n")
    os.exit(0)
end

-- Fast read-only hotplug filter before touching any lock or UI
if cmd == "--hotplug" and not pick_only then
    local cfg = hypr_user.load()
    local ignore = display.should_ignore_hotplug(sub_arg, {
        locked = is_screen_locked(),
        enabled = cfg.display_hotplug_menu ~= false,
    })
    if ignore then
        os.exit(0)
    end
    target_override = sub_arg
    cmd = "--menu"
    sub_arg = nil
end

-- Split lock phase 1: interactive dmenu picking runs under display-menu.lock (flock -n),
-- releasing display-menu.lock before acquiring display.lock for Hyprland/state mutations.
if not pick_only and not stage_external and not revert_external and is_interactive_pick(cmd, sub_arg) then
    if os.getenv("KAZE_DISPLAY_MENU_LOCKED") ~= "1" and os.getenv("KAZE_DISPLAY_LOCKED") ~= "1" then
        local pick_argv = { "--pick-only", cmd }
        if sub_arg and sub_arg ~= "" then
            pick_argv[#pick_argv + 1] = sub_arg
        end
        if target_override and target_override ~= "" then
            pick_argv[#pick_argv + 1] = "--target"
            pick_argv[#pick_argv + 1] = target_override
        end
        if no_confirm then
            pick_argv[#pick_argv + 1] = "--no-confirm"
        end
        local st, out = run_locked_subcmd(menu_lock_path(), nil, "KAZE_DISPLAY_MENU_LOCKED", pick_argv, true)
        if st == 75 then
            os.exit(0)
        elseif st ~= nil then
            if st ~= 0 then
                os.exit(st)
            end
            local trimmed = (out or ""):gsub("^%s+", ""):gsub("%s+$", "")
            if trimmed == "" then
                os.exit(0)
            end
            local ok_p, picked = pcall(json.decode, trimmed)
            if not ok_p or type(picked) ~= "table" or type(picked.cmd) ~= "string" or picked.cmd == "" then
                io.stderr:write("kaze-display: invalid menu selection payload\n")
                os.exit(1)
            end
            cmd = picked.cmd
            sub_arg = (type(picked.arg) == "string" and picked.arg ~= "") and picked.arg or nil
            if type(picked.target) == "string" and picked.target ~= "" then
                target_override = picked.target
            end
        end
    end
end

-- Split lock phase 2: Hyprland/state mutations run strictly under display.lock.
-- Normal mutations use flock -n (drop duplicate key taps); critical lifecycle operations
-- (--on-disconnect, cleanup, --revert-external) wait up to 5s and never silently drop.
if not pick_only and cmd ~= "--list" then
    if revert_external then
        if os.getenv("KAZE_DISPLAY_LOCKED") ~= "1" then
            local rev_argv = { "--revert-external", tostring(confirm_args[1] or ""), tostring(confirm_args[2] or "revert") }
            local st = run_locked_subcmd(mutation_lock_path(), 5, "KAZE_DISPLAY_LOCKED", rev_argv, false)
            if st ~= nil and st ~= 75 then
                os.exit(st)
            elseif st == 75 then
                io.stderr:write("kaze-display: lock timeout after 5s; proceeding with emergency external revert\n")
            end
        end
    elseif cmd == "cleanup" or cmd == "--on-disconnect" then
        if os.getenv("KAZE_DISPLAY_LOCKED") ~= "1" then
            local crit_argv = { cmd }
            if sub_arg and sub_arg ~= "" then
                crit_argv[#crit_argv + 1] = sub_arg
            end
            local st = run_locked_subcmd(mutation_lock_path(), 5, "KAZE_DISPLAY_LOCKED", crit_argv, false)
            if st ~= nil and st ~= 75 then
                os.exit(st)
            elseif st == 75 then
                io.stderr:write("kaze-display: lock timeout after 5s; proceeding with emergency " .. cmd .. "\n")
            end
        end
    elseif cmd == "external" and not no_confirm and not stage_external and os.getenv("KAZE_DISPLAY_LOCKED") ~= "1" then
        local stage_argv = { "--stage-external", "external" }
        if target_override and target_override ~= "" then
            stage_argv[#stage_argv + 1] = "--target"
            stage_argv[#stage_argv + 1] = target_override
        end
        local st, out = run_locked_subcmd(mutation_lock_path(), nil, "KAZE_DISPLAY_LOCKED", stage_argv, true)
        if st == 75 then
            os.exit(0)
        elseif st ~= nil then
            if st ~= 0 then
                os.exit(st)
            end
            local ok_s, staged = pcall(json.decode, (out or ""):gsub("^%s+", ""):gsub("%s+$", ""))
            if not ok_s or type(staged) ~= "table" or staged.needs_confirm ~= true then
                os.exit(0)
            end
            local cst, cout = run_locked_subcmd(menu_lock_path(), nil, "KAZE_DISPLAY_MENU_LOCKED", {
                "--confirm-external",
                tostring(staged.generation or ""),
                tostring(staged.ext_name or "external"),
                tostring(staged.internal_name or "laptop"),
            }, true)
            local verdict = (cst == 0 and type(cout) == "string") and cout:gsub("[\r\n]+$", "") or "revert"
            if verdict == "keep" then
                local rpath = revert_file_path()
                if rpath then os.remove(rpath) end
                notify("External Only confirmed", "Keeping " .. tostring(staged.ext_name or "external") .. " active", "low")
                os.exit(0)
            end
            local rst = run_locked_subcmd(mutation_lock_path(), 5, "KAZE_DISPLAY_LOCKED", {
                "--revert-external",
                tostring(staged.generation or ""),
                verdict,
            }, false)
            if rst ~= nil and rst ~= 75 then
                os.exit(rst)
            elseif rst == 75 then
                io.stderr:write("kaze-display: lock timeout after 5s; proceeding with emergency external revert\n")
                revert_external = true
                confirm_args = { tostring(staged.generation or ""), verdict }
            end
        end
    elseif os.getenv("KAZE_DISPLAY_LOCKED") ~= "1" then
        local mut_argv = { cmd }
        if sub_arg and sub_arg ~= "" then
            mut_argv[#mut_argv + 1] = sub_arg
        end
        if target_override and target_override ~= "" then
            mut_argv[#mut_argv + 1] = "--target"
            mut_argv[#mut_argv + 1] = target_override
        end
        if no_confirm then
            mut_argv[#mut_argv + 1] = "--no-confirm"
        end
        local st = run_locked_subcmd(mutation_lock_path(), nil, "KAZE_DISPLAY_LOCKED", mut_argv, false)
        if st == 75 then
            os.exit(0)
        elseif st ~= nil then
            os.exit(st)
        end
    end
end

-- Handle cleanup first (must never fail logout even if compositor/monitors are unavailable)
if cmd == "cleanup" then
    local state = load_state()
    if state.mirror_pid then
        stop_verified_pid(state.mirror_pid, "wl-mirror")
        state.mirror_pid = nil
    end
    if state.control_pid then
        stop_verified_pid(state.control_pid, "wl-mirror")
        state.control_pid = nil
    end
    if state.preview_pid then
        stop_verified_pid(state.preview_pid, "wl-mirror")
        state.preview_pid = nil
    end
    state.control_on_laptop = nil
    state.saved_laptop_workspace = nil
    state.control_virtual = nil
    state.saved_virtual_laptop_workspace = nil
    state.virtual_preview_suspended = nil
    state.preview_target = nil
    if cmd_exists("hyprctl") then
        local monitors = get_monitors()
        if state.present_workspace then
            restore_workspace_edges(state.present_workspace, "kaze-present-edge")
        end
        if #monitors > 0 then
            cleanup_virtual_share(monitors, state)
        elseif state.virtual_workspace then
            restore_workspace_edges(state.virtual_workspace, "kaze-share-edge")
        end
    end
    restore_bars(state)
    restore_dnd_if_managed(state)
    refresh_present_indicator(nil)
    clear_state()
    os.exit(0)
end

if not cmd_exists("hyprctl") then
    io.stderr:write("kaze-display: hyprctl not found in PATH\n")
    os.exit(1)
end

local monitors = get_monitors()

if revert_external then
    local state = load_state()
    local expected_gen = tonumber(confirm_args[1])
    local reason = confirm_args[2] or "revert"
    local rpath = revert_file_path()
    local rev = nil
    if rpath then
        local raw = fs.read_file(rpath)
        if raw and raw:find("%S") then
            local ok_r, parsed = pcall(json.decode, raw)
            if ok_r and type(parsed) == "table" then
                rev = parsed
            end
        end
    end
    if not expected_gen or tonumber(state.generation) ~= expected_gen or state.mode ~= "external" then
        if rpath and rev and tonumber(rev.generation) == expected_gen then
            os.remove(rpath)
        end
        os.exit(0)
    end

    local rev_plan = rev and type(rev.plan) == "table" and rev.plan or nil
    local int_name = rev and rev.internal_name or nil
    if not rev_plan then
        local fallback_plan = display.plan("internal", monitors)
        if fallback_plan then
            local fallback_int = display.pick_roles(monitors)
            rev_plan = {
                mode = "internal",
                eval_cmds = fallback_plan.eval_cmds,
                needs_reload = fallback_plan.needs_reload,
                internal_name = fallback_int and fallback_int.name or nil,
                target_ext = nil,
            }
            int_name = rev_plan.internal_name
        end
    end

    if rev_plan then
        local primary_target = int_name and { name = int_name } or nil
        apply_plan(rev_plan, state, primary_target, rev_plan.mode, monitors)
        if int_name and int_name ~= "" then
            wait_for_monitor_awake(int_name, 5)
            hypr_eval(string.format("hl.dispatch(hl.dsp.focus({ monitor = %q }))", int_name))
        end
        state.mode = (rev_plan.mode == "auto") and (state.virtual_monitor and "virtual-share" or nil) or rev_plan.mode
        state.external_monitor = (rev_plan.mode == "internal") and nil or rev_plan.target_ext
        save_state(state)
        refresh_present_indicator(state)
    end
    if rpath then
        os.remove(rpath)
    end
    local detail = (reason == "timeout")
        and ("Auto-reverted to " .. tostring(int_name or "laptop") .. " after timeout")
        or ("Restored " .. tostring(int_name or "laptop"))
    notify("External Only reverted", detail, "normal")
    os.exit(0)
end

if cmd == "--on-disconnect" then
    local state = load_state()
    local rec = display.plan_disconnect_recovery(sub_arg, monitors, state)
    if rec.ignored then
        os.exit(0)
    end
    local has_mutation = rec.recover_internal
        or rec.ext_affected
        or rec.clear_present
        or rec.cleanup_mirror
        or rec.restore_bar
        or rec.restore_dnd
        or (#rec.eval_cmds > 0)
    -- Disabling the internal panel during External Only fires monitor.removed on Hyprland 0.57+;
    -- exit without saving state so we never bump state.generation and cancel the 15s auto-revert.
    if not has_mutation then
        os.exit(0)
    end
    if rec.cleanup_mirror and state.mirror_pid then
        stop_verified_pid(state.mirror_pid, "wl-mirror")
        state.mirror_pid = nil
    end
    if state.control_virtual and (rec.recover_internal or rec.ext_affected) then
        if state.control_pid then
            stop_verified_pid(state.control_pid, "wl-mirror")
            state.control_pid = nil
        end
        state.control_virtual = nil
        state.saved_virtual_laptop_workspace = nil
        state.virtual_preview_suspended = nil
    end
    if rec.clear_present then
        if state.present_workspace then
            restore_workspace_edges(state.present_workspace, "kaze-present-edge")
        end
        if state.preview_pid and state.preview_target ~= "kaze-share" then
            stop_verified_pid(state.preview_pid, "wl-mirror")
            state.preview_pid = nil
            state.preview_target = nil
        end
        state.control_on_laptop = nil
        state.saved_laptop_workspace = nil
    end
    if #rec.eval_cmds > 0 then
        save_runtime_monitors(rec.eval_cmds, state)
    elseif rec.ext_affected then
        clear_runtime_monitors(state.virtual_monitor == "kaze-share")
    end
    ensure_dpms_awake(monitors)
    if rec.needs_reload then
        os.execute("hyprctl reload >/dev/null 2>&1")
        os.execute("sleep 0.15")
    end
    for _, expr in ipairs(rec.eval_cmds) do
        hypr_eval(expr)
    end
    local d_int, d_exts = display.pick_roles(monitors)
    local fallback_mon = (rec.internal_name and { name = rec.internal_name })
        or display.pick_primary_enabled(d_int, d_exts)
    if rec.recover_internal then
        os.execute("sleep 0.12")
        -- Rescue any non-virtual workspaces that Hyprland temporarily migrated onto kaze-share
        -- when external display disconnected while eDP-1 was disabled (External Only + Virtual Share).
        if rec.internal_name and state.virtual_monitor == "kaze-share" then
            local vws = tonumber(state.virtual_workspace) or -1
            local wss = get_workspaces_and_clients()
            for _, w in ipairs(wss) do
                if w.monitor == "kaze-share" and w.id ~= vws then
                    hypr_eval(string.format(
                        "hl.dispatch(hl.dsp.workspace.move({ workspace = %q, monitor = %q }))",
                        tostring(w.id), rec.internal_name
                    ))
                end
            end
            hypr_eval(string.format("hl.dispatch(hl.dsp.focus({ monitor = %q }))", rec.internal_name))
        end
    end
    if rec.needs_reload then
        os.execute("sleep 0.25")
        reapply_virtual_share_after_reload(state, fallback_mon)
    end
    if rec.restore_bar then
        restore_bars(state)
    end
    if rec.restore_dnd then
        restore_dnd_if_managed(state)
    end
    if rec.ext_affected or rec.clear_present then
        state.external_monitor = nil
        state.present_workspace = nil
        state.control_on_laptop = nil
        state.saved_laptop_workspace = nil
        if state.virtual_monitor == "kaze-share" then
            state.mode = rec.recover_internal and "internal" or "virtual-share"
        elseif state.mode ~= "virtual-share" then
            state.mode = rec.recover_internal and "internal" or nil
        end
    end
    save_state(state)
    refresh_present_indicator(state)
    -- If External Only confirmation was open on the unplugged output, reset Noctalia's
    -- launcher panel state so future `noctalia dmenu` invocations stay unblocked.
    local rpath = revert_file_path()
    if rec.recover_internal and rpath and fs.file_exists(rpath) then
        os.remove(rpath)
        if cmd_exists("noctalia") then
            os.execute("noctalia msg panel-open launcher >/dev/null 2>&1 || true; noctalia msg panel-close launcher >/dev/null 2>&1 || true")
        end
    end
    if rec.recover_internal then
        notify("Display recovered", "External display disconnected; restored " .. tostring(rec.internal_name), "normal")
    elseif rec.clear_present or rec.cleanup_mirror then
        notify("Display updated", sub_arg .. " disconnected; presentation state cleaned up", "low")
    end
    os.exit(0)
end

if #monitors == 0 then
    io.stderr:write("kaze-display: no monitors reported by hyprctl\n")
    os.exit(1)
end

if cmd == "--list" then
    for _, m in ipairs(monitors) do
        io.stdout:write(display.format_monitor(m) .. "\n")
    end
    os.exit(0)
end

if cmd == "--hotplug" then
    local cfg = hypr_user.load()
    local ignore = display.should_ignore_hotplug(sub_arg, {
        locked = is_screen_locked(),
        enabled = cfg.display_hotplug_menu ~= false,
    })
    if ignore then
        os.exit(0)
    end
    target_override = sub_arg
    cmd = "--menu"
    sub_arg = nil
end

local state = load_state()
local internal, externals = display.pick_roles(monitors)
local primary_phys = display.pick_primary_enabled(internal, externals)
local target_ext = nil
if type(target_override) == "string" and target_override ~= "" then
    target_ext = find_monitor_by_name(externals, target_override)
end
target_ext = target_ext or externals[1]

local function run_present(ws_arg, ext_mon)
    if not ext_mon then
        io.stderr:write("kaze-display: no external monitor connected\n")
        notify("Present skipped", "No external monitor connected", "normal")
        os.exit(1)
    end
    local ws_id = ws_arg
    local existing_ws = nil
    if not ws_id or ws_id == "" then
        local current_ws = (primary_phys and primary_phys.active_workspace) or (internal and internal.active_workspace) or nil
        local picked, wss, perr = pick_workspace_via_dmenu(
            "Present WS > ",
            current_ws,
            { state.present_workspace, state.virtual_workspace }
        )
        if picked == nil then
            io.stderr:write("kaze-display: " .. tostring(perr) .. "\n")
            os.exit(1)
        end
        if picked == "" then
            os.exit(0)
        end
        ws_id = picked
        existing_ws = wss
    else
        existing_ws = get_workspaces_and_clients()
    end

    if state.mirror_pid then
        stop_verified_pid(state.mirror_pid, "wl-mirror")
        state.mirror_pid = nil
    end
    if state.control_virtual or state.control_pid then
        stop_virtual_control(state, internal or primary_phys, false)
    end
    if state.preview_pid and state.preview_target ~= "kaze-share" then
        stop_verified_pid(state.preview_pid, "wl-mirror")
        state.preview_pid = nil
        state.preview_target = nil
    end
    local was_mirror = (state.mode == "mirror" or state.control_on_laptop == true)
    local woke_disabled_output = (ext_mon.disabled == true) or (internal ~= nil and internal.disabled == true)
    state.control_on_laptop = nil
    state.saved_laptop_workspace = nil
    local plan, err = display.plan("present", monitors, {
        target = ext_mon.name,
        was_mirror = was_mirror,
    })
    if not plan then
        io.stderr:write("kaze-display: " .. tostring(err) .. "\n")
        os.exit(1)
    end
    if not apply_plan(plan, state, internal or primary_phys, "present", monitors) then
        os.exit(1)
    end
    if woke_disabled_output then
        wait_for_monitor_awake(ext_mon.name, 5)
    end
    if state.present_workspace and tostring(state.present_workspace) ~= tostring(ws_id) then
        evacuate_workspace_to_primary(
            state.present_workspace,
            "kaze-present-edge",
            state.external_monitor or ext_mon.name,
            internal or primary_phys,
            existing_ws
        )
    end
    -- If the user explicitly moved the virtual-share workspace onto HDMI, assign a fresh workspace to kaze-share.
    if state.virtual_monitor == "kaze-share" and state.virtual_workspace and tostring(state.virtual_workspace) == tostring(ws_id) then
        local replacement_ws = display.pick_clean_workspace_id(build_occupied_workspaces(existing_ws, { ws_id }))
        restore_workspace_edges(ws_id, "kaze-share-edge")
        set_edge_to_edge_workspace(replacement_ws, "kaze-share-edge", "kaze-share")
        move_workspace_to_monitor(replacement_ws, "kaze-share", internal or primary_phys, existing_ws)
        state.virtual_workspace = replacement_ws
    end
    hide_bar_on(state, ext_mon.name)
    enable_managed_dnd(state)
    set_edge_to_edge_workspace(ws_id, "kaze-present-edge", ext_mon.name)
    move_workspace_to_monitor(ws_id, ext_mon.name, internal or primary_phys, existing_ws)
    state.mode = "present"
    state.external_monitor = ext_mon.name
    state.present_workspace = tonumber(ws_id) or ws_id
    save_state(state)
    refresh_present_indicator(state)
    notify("Presenting WS " .. tostring(ws_id), "Placed on " .. ext_mon.name .. " (DND on, bar hidden)", "low")
end

local function run_toggle_virtual_control()
    local share_mon = find_monitor_by_name(monitors, "kaze-share")
    local share_active = (share_mon ~= nil) or (state.virtual_monitor == "kaze-share")
    local primary = primary_phys

    if state.control_virtual == true then
        local control_alive = state.control_pid ~= nil and is_pid_running(state.control_pid, "wl-mirror")
        local share_focused = share_mon ~= nil and share_mon.focused == true
        if control_alive or share_focused or not share_active then
            stop_virtual_control(state, primary, share_active)
            save_state(state)
            refresh_present_indicator(state)
            notify("Exited kaze-share control", "Returned focus to " .. (primary and primary.name or "laptop"), "low")
            return
        end
        -- Stale state (wl-mirror already exited and focus is off kaze-share): clear and re-enter cleanly.
        state.control_virtual = nil
        state.control_pid = nil
        state.saved_virtual_laptop_workspace = nil
        state.virtual_preview_suspended = nil
    end

    if not share_active then
        io.stderr:write("kaze-display: toggle-virtual-control requires an active Virtual Share (kaze-share)\n")
        notify("kaze-share control skipped", "Start Virtual Share… first", "normal")
        os.exit(1)
    end
    if not primary then
        io.stderr:write("kaze-display: no active physical monitor available for control overlay\n")
        os.exit(1)
    end
    if not cmd_exists("wl-mirror") then
        io.stderr:write("kaze-display: wl-mirror is required to control kaze-share directly\n")
        notify("kaze-share control unavailable", "Install wl-mirror from Arch [extra]", "normal")
        os.exit(1)
    end

    if state.preview_pid and (state.preview_target == "kaze-share" or not state.preview_target) then
        if stop_verified_pid(state.preview_pid, "wl-mirror") then
            state.virtual_preview_suspended = true
        end
        state.preview_pid = nil
        state.preview_target = nil
    end

    state.saved_virtual_laptop_workspace = primary.active_workspace
    local pid, err = spawn_wl_mirror({
        "--title", "kaze-share-control",
        "--fullscreen-output", primary.name,
        "--show-cursor",
        "kaze-share",
    })
    if not pid then
        io.stderr:write("kaze-display: " .. tostring(err) .. "\n")
        notify("kaze-share control failed", tostring(err), "normal")
        os.exit(1)
    end

    -- Wait briefly for wl-mirror to map its fullscreen surface on primary before focusing
    -- kaze-share so the newly mapped fullscreen output cannot pull monitor focus back.
    wait_for_window_title("kaze-share-control", 12)
    hypr_eval('hl.dispatch(hl.dsp.focus({ monitor = "kaze-share" }))')
    state.control_virtual = true
    state.control_pid = pid
    save_state(state)
    refresh_present_indicator(state)
    local share_ws = state.virtual_workspace or (share_mon and share_mon.active_workspace) or 9
    notify(
        "Controlling kaze-share directly",
        "Keyboard & mouse active on WS " .. tostring(share_ws) .. " (Ctrl+Super+P to return)",
        "low"
    )
end

local function run_toggle_control()
    if state.control_virtual == true then
        run_toggle_virtual_control()
        return
    end
    if state.mode ~= "present" or not state.present_workspace then
        local share_mon = find_monitor_by_name(monitors, "kaze-share")
        if share_mon ~= nil or state.virtual_monitor == "kaze-share" then
            run_toggle_virtual_control()
            return
        end
        io.stderr:write("kaze-display: toggle-control requires an active HDMI presentation or Virtual Share\n")
        notify("Control toggle skipped", "Start Present Workspace… or Virtual Share… first", "normal")
        os.exit(1)
    end
    local ext_mon = (state.external_monitor and find_monitor_by_name(externals, state.external_monitor)) or target_ext
    if not ext_mon or not internal then
        io.stderr:write("kaze-display: external and internal monitors are required\n")
        notify("Control toggle skipped", "External monitor not connected", "normal")
        os.exit(1)
    end

    local pws = state.present_workspace
    local pws_str = tostring(pws)

    if not state.control_on_laptop then
        if state.preview_pid and state.preview_target ~= "kaze-share" then
            stop_verified_pid(state.preview_pid, "wl-mirror")
            state.preview_pid = nil
            state.preview_target = nil
        end
        state.saved_laptop_workspace = (internal and internal.active_workspace) or 1
        restore_workspace_edges(pws, "kaze-present-edge")

        local existing_ws = get_workspaces_and_clients()
        local exists = false
        for _, w in ipairs(existing_ws) do
            if w.id == tonumber(pws) then
                exists = true
                break
            end
        end
        if exists then
            hypr_eval(string.format("hl.dispatch(hl.dsp.workspace.move({ workspace = %q, monitor = %q }))", pws_str, internal.name))
        end
        hypr_eval(string.format(
            "hl.dispatch(hl.dsp.focus({ monitor = %q })); hl.dispatch(hl.dsp.focus({ workspace = %q }))",
            internal.name, pws_str
        ))

        local plan, err = display.plan("mirror", monitors, { target = ext_mon.name })
        if not plan then
            io.stderr:write("kaze-display: " .. tostring(err) .. "\n")
            os.exit(1)
        end
        if not apply_plan(plan, state, internal, "mirror", monitors) then
            os.exit(1)
        end
        state.control_on_laptop = true
        save_state(state)
        notify("Controlling WS " .. pws_str .. " on laptop", "Mirrored to " .. ext_mon.name .. " (Ctrl+Super+P to return)", "low")
    else
        local plan, err = display.plan("present", monitors, {
            target = ext_mon.name,
            was_mirror = true,
        })
        if not plan then
            io.stderr:write("kaze-display: " .. tostring(err) .. "\n")
            os.exit(1)
        end
        if not apply_plan(plan, state, internal, "present", monitors) then
            os.exit(1)
        end
        hide_bar_on(state, ext_mon.name)
        local existing_ws = get_workspaces_and_clients()
        set_edge_to_edge_workspace(pws, "kaze-present-edge", ext_mon.name)
        move_workspace_to_monitor(pws, ext_mon.name, internal, existing_ws)

        if state.saved_laptop_workspace and tonumber(state.saved_laptop_workspace) ~= tonumber(pws) then
            hypr_eval(string.format(
                "hl.dispatch(hl.dsp.focus({ monitor = %q })); hl.dispatch(hl.dsp.focus({ workspace = %q }))",
                internal.name, tostring(state.saved_laptop_workspace)
            ))
        else
            hypr_eval(string.format("hl.dispatch(hl.dsp.focus({ monitor = %q }))", internal.name))
        end

        state.control_on_laptop = false
        state.saved_laptop_workspace = nil
        save_state(state)
        notify("Returned WS " .. pws_str .. " to " .. ext_mon.name, "Private laptop mode restored", "low")
    end
end

local function run_stop_present(is_mirror_stop)
    if state.mirror_pid then
        stop_verified_pid(state.mirror_pid, "wl-mirror")
        state.mirror_pid = nil
    end
    if state.preview_pid and state.preview_target ~= "kaze-share" then
        stop_verified_pid(state.preview_pid, "wl-mirror")
        state.preview_pid = nil
        state.preview_target = nil
    end

    local ext_mon = (state.external_monitor and find_monitor_by_name(externals, state.external_monitor)) or target_ext
    local dest_primary = (internal and not internal.disabled and internal) or primary_phys
    local ext_mirrored = ext_mon and type(ext_mon.mirror_of) == "string" and ext_mon.mirror_of ~= "" and ext_mon.mirror_of ~= "none"
    if state.control_on_laptop == true or state.mode == "mirror" or ext_mirrored then
        if ext_mon then
            local plan = display.plan("extend-right", monitors, { target = ext_mon.name, was_mirror = true })
            if plan then
                apply_plan(plan, state, dest_primary, "extend-right", monitors)
            end
        else
            clear_runtime_monitors(state.virtual_monitor == "kaze-share")
            os.execute("hyprctl reload >/dev/null 2>&1")
            os.execute("sleep 0.25")
            reapply_virtual_share_after_reload(state, dest_primary)
        end
        if state.present_workspace then
            restore_workspace_edges(state.present_workspace, "kaze-present-edge")
        end
    elseif state.present_workspace then
        evacuate_workspace_to_primary(
            state.present_workspace,
            "kaze-present-edge",
            ext_mon and ext_mon.name or state.external_monitor,
            dest_primary
        )
    end

    state.control_on_laptop = nil
    state.saved_laptop_workspace = nil
    restore_bars(state)
    restore_dnd_if_managed(state)
    state.present_workspace = nil
    if state.mode == "present" or state.mode == "mirror" or state.mode == "mirror-scaled" then
        state.mode = (ext_mon ~= nil) and "extend-right" or (state.virtual_monitor and "virtual-share" or nil)
    end
    save_state(state)
    refresh_present_indicator(state)
    if is_mirror_stop then
        notify("Mirror stopped", "Returned to extended display; DND restored", "low")
    else
        notify("Presentation stopped", "Bar and notification settings restored", "low")
    end
end

local function run_virtual_share(ws_arg, interactive_pick)
    local primary = primary_phys
    if not primary then
        io.stderr:write("kaze-display: no physical monitor available\n")
        os.exit(1)
    end
    local existing_ws = nil
    local ws_id = nil
    if ws_arg ~= nil and ws_arg ~= "" then
        ws_id = tonumber(ws_arg) or ws_arg
        existing_ws = get_workspaces_and_clients()
    elseif interactive_pick == true then
        local current_ws = primary and primary.active_workspace or nil
        local picked, wss, perr = pick_workspace_via_dmenu(
            "Virtual Share WS > ",
            current_ws,
            { state.present_workspace, state.virtual_workspace }
        )
        if picked == nil then
            io.stderr:write("kaze-display: " .. tostring(perr) .. "\n")
            os.exit(1)
        end
        if picked == "" then
            os.exit(0)
        end
        ws_id = picked
        existing_ws = wss
    else
        existing_ws = get_workspaces_and_clients()
        ws_id = display.pick_clean_workspace_id(build_occupied_workspaces(existing_ws, { state.present_workspace, state.virtual_workspace }))
    end

    local created_new = not find_monitor_by_name(monitors, "kaze-share")
    if created_new then
        local ok_create = os.execute("hyprctl output create headless kaze-share >/dev/null 2>&1")
        if not (ok_create == true or ok_create == 0) then
            io.stderr:write("kaze-display: failed to create headless kaze-share output\n")
            notify("Virtual Share failed", "Could not create headless output", "critical")
            os.exit(1)
        end
    end

    local stealing_present = state.present_workspace and tostring(state.present_workspace) == tostring(ws_id)
    if stealing_present and state.control_on_laptop == true then
        local ext_mon = (state.external_monitor and find_monitor_by_name(externals, state.external_monitor)) or target_ext
        if ext_mon then
            local unmir = display.plan("extend-right", monitors, { target = ext_mon.name, was_mirror = true })
            if unmir then
                apply_plan(unmir, state, primary, "extend-right", monitors)
            end
        end
    end

    state.virtual_monitor = "kaze-share"
    local plan, err = display.plan("virtual-share", monitors)
    if not plan then
        io.stderr:write("kaze-display: " .. tostring(err) .. "\n")
        os.exit(1)
    end
    if not apply_plan(plan, state, primary, "virtual-share", monitors) then
        os.exit(1)
    end
    if created_new then
        os.execute("sleep 0.12")
    end
    if stealing_present then
        restore_workspace_edges(state.present_workspace, "kaze-present-edge")
        state.present_workspace = nil
        state.control_on_laptop = nil
        state.saved_laptop_workspace = nil
        if state.mode == "present" then
            restore_bars(state)
            restore_dnd_if_managed(state)
            state.mode = target_ext and "extend-right" or "virtual-share"
        end
    end
    if state.virtual_workspace and tostring(state.virtual_workspace) ~= tostring(ws_id) then
        evacuate_workspace_to_primary(state.virtual_workspace, "kaze-share-edge", "kaze-share", primary, existing_ws)
    end
    if cmd_exists("noctalia") then
        for _, bar_name in ipairs(active_bar_names()) do
            os.execute("noctalia msg bar-hide " .. fs.shell_quote(bar_name) .. " kaze-share >/dev/null 2>&1 || true")
        end
    end
    set_edge_to_edge_workspace(ws_id, "kaze-share-edge", "kaze-share")
    move_workspace_to_monitor(ws_id, "kaze-share", primary, existing_ws)
    state.virtual_monitor = "kaze-share"
    state.virtual_workspace = tonumber(ws_id) or ws_id
    if not state.mode then
        state.mode = "virtual-share"
    end
    save_state(state)
    refresh_present_indicator(state)
    notify("Virtual Share ready (WS " .. tostring(ws_id) .. ")", "Share Screen → kaze-share in Meet/Discord; Super+Alt+P pushes windows", "low")
end

local function run_switch_share(ws_arg)
    local share_mon = find_monitor_by_name(monitors, "kaze-share")
    if not share_mon and state.virtual_monitor ~= "kaze-share" then
        io.stderr:write("kaze-display: kaze-share is not active\n")
        os.exit(1)
    end
    local primary = primary_phys
    local ws_id = ws_arg
    local existing_ws = nil
    if not ws_id or ws_id == "" then
        local current_ws = primary and primary.active_workspace or nil
        local picked, wss, perr = pick_workspace_via_dmenu(
            "Virtual Share WS > ",
            current_ws,
            { state.present_workspace, state.virtual_workspace }
        )
        if picked == nil then
            io.stderr:write("kaze-display: " .. tostring(perr) .. "\n")
            os.exit(1)
        end
        if picked == "" then
            os.exit(0)
        end
        ws_id = picked
        existing_ws = wss
    else
        existing_ws = get_workspaces_and_clients()
    end
    if state.virtual_workspace and tostring(state.virtual_workspace) ~= tostring(ws_id) then
        evacuate_workspace_to_primary(state.virtual_workspace, "kaze-share-edge", "kaze-share", primary, existing_ws)
    end
    set_edge_to_edge_workspace(ws_id, "kaze-share-edge", "kaze-share")
    move_workspace_to_monitor(ws_id, "kaze-share", primary, existing_ws)
    if state.control_virtual == true then
        hypr_eval('hl.dispatch(hl.dsp.focus({ monitor = "kaze-share" }))')
    end
    state.virtual_monitor = "kaze-share"
    state.virtual_workspace = tonumber(ws_id) or ws_id
    save_state(state)
    refresh_present_indicator(state)
    notify("Virtual Share switched", "Showing WS " .. tostring(ws_id) .. " on kaze-share", "low")
end

local function run_toggle_preview()
    if state.preview_pid and stop_verified_pid(state.preview_pid, "wl-mirror") then
        state.preview_pid = nil
        state.preview_target = nil
        save_state(state)
        notify("Share preview closed", "Closed floating preview window", "low")
        return
    end
    local share_mon = find_monitor_by_name(monitors, "kaze-share")
    local preview_target = nil
    if share_mon or state.virtual_monitor == "kaze-share" then
        preview_target = "kaze-share"
    elseif state.mode == "present" and not state.control_on_laptop then
        local ext_mon = (state.external_monitor and find_monitor_by_name(externals, state.external_monitor)) or target_ext
        preview_target = ext_mon and ext_mon.name or nil
    end
    if not preview_target then
        io.stderr:write("kaze-display: no active virtual share or HDMI presentation to preview\n")
        os.exit(1)
    end
    if preview_target == "kaze-share" and state.control_virtual == true then
        stop_virtual_control(state, primary_phys, false)
    end
    local pid, err = spawn_wl_mirror({ "--title", "kaze-share-preview", preview_target })
    if not pid then
        io.stderr:write("kaze-display: " .. tostring(err) .. "\n")
        notify("Preview failed", tostring(err), "normal")
        os.exit(1)
    end
    state.preview_pid = pid
    state.preview_target = preview_target
    save_state(state)
    refresh_present_indicator(state)
    notify("Share preview opened", "Floating preview of " .. preview_target, "low")
end

local function run_toggle_window_share()
    local share_mon = find_monitor_by_name(monitors, "kaze-share")
    local ext_mon = (state.external_monitor and find_monitor_by_name(externals, state.external_monitor)) or target_ext
    local present_ready = state.mode == "present" and not state.control_on_laptop and state.present_workspace and ext_mon

    if not share_mon and not present_ready then
        io.stderr:write("kaze-display: no active Virtual Share or HDMI presentation\n")
        notify("Window share inactive", "Start Present or Virtual Share from Super+Shift+P first", "normal")
        os.exit(1)
    end

    local primary = primary_phys
    local active_raw = fs.capture("hyprctl -j activewindow 2>/dev/null") or "{}"
    local ok_w, win = pcall(json.decode, active_raw)
    if not ok_w or type(win) ~= "table" or not win.address or win.address == "" then
        notify("Share", "No focused window to move", "low")
        os.exit(0)
    end

    local primary_ws = (primary and primary.active_workspace) or 1
    local win_ws = type(win.workspace) == "table" and tonumber(win.workspace.id) or nil

    -- If focused window is already on either shared target, pull it back to primary workspace.
    if share_mon then
        local share_ws = state.virtual_workspace or share_mon.active_workspace or 9
        if (share_mon.id ~= nil and win.monitor == share_mon.id) or (win_ws ~= nil and win_ws == tonumber(share_ws)) then
            hypr_eval(string.format("hl.dispatch(hl.dsp.window.move({ workspace = %q, silent = true }))", tostring(primary_ws)))
            if state.control_virtual == true then
                hypr_eval('hl.dispatch(hl.dsp.focus({ monitor = "kaze-share" }))')
            elseif primary then
                hypr_eval(string.format("hl.dispatch(hl.dsp.focus({ monitor = %q }))", primary.name))
            end
            notify("Virtual Share", "Pulled window back to WS " .. tostring(primary_ws), "low")
            return
        end
    end
    if present_ready then
        local pws = state.present_workspace
        if (ext_mon.id ~= nil and win.monitor == ext_mon.id) or (win_ws ~= nil and win_ws == tonumber(pws)) then
            hypr_eval(string.format("hl.dispatch(hl.dsp.window.move({ workspace = %q, silent = true }))", tostring(primary_ws)))
            if primary then
                hypr_eval(string.format("hl.dispatch(hl.dsp.focus({ monitor = %q }))", primary.name))
            end
            notify("Presentation", "Pulled window back to WS " .. tostring(primary_ws), "low")
            return
        end
    end

    local target_ws = share_mon and (state.virtual_workspace or share_mon.active_workspace or 9) or state.present_workspace
    local mode_label = share_mon and "Virtual Share" or "Presentation"
    hypr_eval(string.format("hl.dispatch(hl.dsp.window.move({ workspace = %q, silent = true }))", tostring(target_ws)))
    if primary then
        hypr_eval(string.format("hl.dispatch(hl.dsp.focus({ monitor = %q }))", primary.name))
    end
    notify(mode_label, "Pushed window to WS " .. tostring(target_ws), "low")
end

local function run_stop_virtual()
    cleanup_virtual_share(monitors, state)
    save_state(state)
    refresh_present_indicator(state)
    notify("Virtual Share stopped", "Windows moved back and kaze-share removed", "low")
end

local function run_standard_mode(mode_name)
    if mode_name == "mirror-scaled" and not cmd_exists("wl-mirror") then
        io.stderr:write("kaze-display: wl-mirror is required for mirror-scaled\n")
        notify("Scaled mirror unavailable", "Install wl-mirror from Arch [extra]", "normal")
        os.exit(1)
    end

    if state.mirror_pid then
        stop_verified_pid(state.mirror_pid, "wl-mirror")
        state.mirror_pid = nil
    end
    if state.control_virtual or state.control_pid then
        stop_virtual_control(state, primary_phys, false)
    end
    if state.preview_pid and state.preview_target ~= "kaze-share" then
        stop_verified_pid(state.preview_pid, "wl-mirror")
        state.preview_pid = nil
        state.preview_target = nil
    end

    local was_mirror = (state.mode == "mirror" or state.control_on_laptop == true)
    local prev_present_ws = state.present_workspace
    local prev_ext_name = state.external_monitor or (target_ext and target_ext.name) or nil
    local woke_disabled = (internal and internal.disabled and mode_name ~= "external")
        or (target_ext and target_ext.disabled and mode_name ~= "internal")
    local external_needs_confirm = (mode_name == "external")
        and (not no_confirm)
        and (internal ~= nil)
        and (internal.disabled ~= true)
    local revert_plan = nil
    if external_needs_confirm then
        revert_plan = display.plan_external_revert(monitors, state, {
            target = target_ext and target_ext.name or nil,
        })
    end
    state.control_on_laptop = nil
    state.saved_laptop_workspace = nil

    local plan, err = display.plan(mode_name, monitors, {
        target = target_ext and target_ext.name or nil,
        was_mirror = was_mirror,
    })
    if not plan then
        io.stderr:write("kaze-display: " .. tostring(err) .. "\n")
        notify("Display switch skipped", tostring(err), "normal")
        os.exit(1)
    end

    -- Safety guard for External Only: enable external output first and confirm it woke up
    -- before disabling the internal panel so both screens can never go black simultaneously.
    if mode_name == "external" and target_ext and target_ext.disabled then
        ensure_dpms_awake(monitors)
        if plan.needs_reload then
            clear_runtime_monitors(state.virtual_monitor == "kaze-share")
            os.execute("hyprctl reload >/dev/null 2>&1")
            os.execute("sleep 0.15")
        end
        local enable_cmds = {}
        local disable_cmds = {}
        for _, expr in ipairs(plan.eval_cmds) do
            if expr:find("disabled = true", 1, true) then
                disable_cmds[#disable_cmds + 1] = expr
            else
                enable_cmds[#enable_cmds + 1] = expr
            end
        end
        for _, expr in ipairs(enable_cmds) do
            hypr_eval(expr)
        end
        if not wait_for_monitor_awake(target_ext.name, 6) then
            if internal then
                hypr_eval(string.format(
                    'hl.monitor({ output = %q, mode = "preferred", position = "0x0", scale = 1, disabled = false, mirror = "" })',
                    internal.name
                ))
            end
            io.stderr:write("kaze-display: external monitor failed to wake; kept laptop panel active\n")
            notify("External Only aborted", target_ext.name .. " did not wake; kept laptop display on", "critical")
            os.exit(1)
        end
        for _, expr in ipairs(disable_cmds) do
            hypr_eval(expr)
        end
        save_runtime_monitors(plan.eval_cmds, state)
        if plan.needs_reload then
            os.execute("sleep 0.25")
            reapply_virtual_share_after_reload(state, target_ext)
        end
    else
        local post_primary = (mode_name == "external" and target_ext) or internal or primary_phys
        if not apply_plan(plan, state, post_primary, mode_name, monitors) then
            os.exit(1)
        end
        if woke_disabled then
            local wake_name = (target_ext and target_ext.disabled and mode_name ~= "internal" and target_ext.name)
                or (internal and internal.disabled and mode_name ~= "external" and internal.name)
                or nil
            if wake_name then
                wait_for_monitor_awake(wake_name, 5)
            else
                os.execute("sleep 0.15")
            end
        end
    end

    if prev_present_ws then
        local dest_mon = (mode_name == "external" and target_ext) or internal or primary_phys
        evacuate_workspace_to_primary(prev_present_ws, "kaze-present-edge", prev_ext_name, dest_mon)
    end

    if mode_name == "mirror" then
        restore_bars(state)
        enable_managed_dnd(state)
        state.mode = "mirror"
        state.external_monitor = plan.target_ext
        state.present_workspace = nil
    elseif mode_name == "mirror-scaled" then
        hide_bar_on(state, plan.target_ext)
        enable_managed_dnd(state)
        local pid, merr = spawn_wl_mirror({ "--fullscreen-output", plan.target_ext, internal.name })
        if not pid then
            restore_bars(state)
            restore_dnd_if_managed(state)
            io.stderr:write("kaze-display: " .. tostring(merr) .. "\n")
            os.exit(1)
        end
        state.mirror_pid = pid
        state.mode = "mirror-scaled"
        state.external_monitor = plan.target_ext
        state.present_workspace = nil
    else
        restore_bars(state)
        restore_dnd_if_managed(state)
        state.present_workspace = nil
        state.external_monitor = (mode_name == "internal") and nil or plan.target_ext
        state.mode = (mode_name == "auto") and (state.virtual_monitor and "virtual-share" or nil) or mode_name
    end

    save_state(state)
    refresh_present_indicator(state)

    if mode_name == "external" and external_needs_confirm and revert_plan then
        local rpath = revert_file_path()
        if rpath then
            pcall(fs.write_atomic, rpath, json.encode({
                generation = state.generation,
                ext_name = plan.target_ext,
                internal_name = revert_plan.internal_name,
                plan = revert_plan,
            }))
        end
        if stage_external then
            io.stdout:write(json.encode({
                needs_confirm = true,
                generation = state.generation,
                ext_name = plan.target_ext,
                internal_name = revert_plan.internal_name,
            }) .. "\n")
            return
        end
        -- Inline fallback when flock is unavailable
        local verdict = run_external_confirm_dialog(plan.target_ext, revert_plan.internal_name)
        if verdict == "keep" then
            if rpath then os.remove(rpath) end
            notify("External Only confirmed", "Keeping " .. tostring(plan.target_ext) .. " active", "low")
            return
        end
        local cur_state = load_state()
        if tonumber(cur_state.generation) == tonumber(state.generation) and cur_state.mode == "external" then
            local live_mons = get_monitors()
            apply_plan(revert_plan, cur_state, { name = revert_plan.internal_name }, revert_plan.mode, live_mons)
            if revert_plan.internal_name then
                wait_for_monitor_awake(revert_plan.internal_name, 5)
                hypr_eval(string.format("hl.dispatch(hl.dsp.focus({ monitor = %q }))", revert_plan.internal_name))
            end
            cur_state.mode = (revert_plan.mode == "auto") and (cur_state.virtual_monitor and "virtual-share" or nil) or revert_plan.mode
            cur_state.external_monitor = (revert_plan.mode == "internal") and nil or revert_plan.target_ext
            save_state(cur_state)
            refresh_present_indicator(cur_state)
            if rpath then os.remove(rpath) end
            notify("External Only reverted", "Restored " .. tostring(revert_plan.internal_name), "normal")
        end
        return
    elseif stage_external then
        io.stdout:write(json.encode({ needs_confirm = false }) .. "\n")
    end

    notify("Display updated", plan.summary, "low")
end

local function run_dmenu_entries(entries, prompt_text)
    local labels = {}
    local by_label = {}
    for _, e in ipairs(entries) do
        labels[#labels + 1] = e.label
        by_label[e.label] = { action = e.action, arg = e.arg }
    end
    local choice, dmenu_err = popups.run_dmenu(labels, { prompt = prompt_text })
    if not choice then
        io.stderr:write("kaze-display: " .. tostring(dmenu_err) .. "\n")
        os.exit(1)
    end
    if choice == "" then
        os.exit(0)
    end
    local picked = by_label[choice]
    if not picked then
        io.stderr:write(string.format("kaze-display: unrecognized selection '%s'\n", choice))
        os.exit(1)
    end
    return picked
end

if cmd == "--menu" then
    local ext = target_ext
    local share_mon = find_monitor_by_name(monitors, "kaze-share")
    local share_active = share_mon ~= nil or state.virtual_monitor == "kaze-share"
    local present_active = (state.mode == "present")
    local mirror_active = not present_active and (
        state.mode == "mirror"
        or state.mode == "mirror-scaled"
        or (ext ~= nil and type(ext.mirror_of) == "string" and ext.mirror_of ~= "" and ext.mirror_of ~= "none")
    )
    local has_wl_mirror = cmd_exists("wl-mirror")
    local workspaces = get_workspaces_and_clients()
    local current_ws = (primary_phys and primary_phys.active_workspace)
        or (internal and internal.active_workspace)
        or (workspaces[1] and workspaces[1].id)
        or 1
    local present_ws = state.present_workspace or (ext and ext.active_workspace) or current_ws
    local present_ext_name = state.external_monitor or (ext and ext.name) or "external"
    local share_ws = state.virtual_workspace or (share_mon and share_mon.active_workspace) or 9
    local entries = {}

    if mirror_active then
        local mir_mon = state.external_monitor or (ext and ext.name) or "external"
        entries[#entries + 1] = { label = string.format("󰅖  Stop Mirror (%s)", mir_mon), action = "stop-mirror" }
    end
    if present_active then
        if ext ~= nil then
            if state.control_on_laptop then
                entries[#entries + 1] = { label = string.format("󰌢  Back to Private Laptop (return WS %s → %s)", tostring(present_ws), present_ext_name), action = "toggle-control" }
            else
                entries[#entries + 1] = { label = string.format("󰍹  Control WS %s on Laptop (Mirror)", tostring(present_ws)), action = "toggle-control" }
            end
        end
        entries[#entries + 1] = { label = string.format("󰅖  Stop Presentation (WS %s)", tostring(present_ws)), action = "stop-present" }
    end
    if share_active then
        if state.control_virtual then
            entries[#entries + 1] = {
                label = string.format("󰌢  Exit kaze-share Control (return to %s)", primary_phys and primary_phys.name or "laptop"),
                action = "toggle-virtual-control",
            }
        elseif has_wl_mirror then
            entries[#entries + 1] = {
                label = string.format("󰍹  Control kaze-share Directly (WS %s)", tostring(share_ws)),
                action = "toggle-virtual-control",
            }
        end
        entries[#entries + 1] = { label = string.format("󰍹  Switch Virtual Share (WS %s)…", tostring(share_ws)), action = "switch-share" }
        if has_wl_mirror then
            entries[#entries + 1] = { label = "󰹑  Toggle Share Preview (kaze-share)", action = "toggle-preview" }
        end
        entries[#entries + 1] = { label = string.format("󰅖  Stop Virtual Share (WS %s)", tostring(share_ws)), action = "stop-virtual" }
    end

    if ext then
        entries[#entries + 1] = { label = "󰍹  Mirror Full Screen", action = "mirror" }
        entries[#entries + 1] = { label = "󰐨  Present Workspace…", action = "present" }
        if not share_active then
            entries[#entries + 1] = { label = "󰕧  Virtual Share (Meet / Discord 1080p)…", action = "virtual-share-pick" }
        end
        entries[#entries + 1] = { label = "󰹑  Extend / Layout…", action = "submenu-extend" }
    else
        if not share_active then
            entries[#entries + 1] = { label = "󰕧  Virtual Share (Meet / Discord 1080p)…", action = "virtual-share-pick" }
        end
        entries[#entries + 1] = { label = "󰑓  Auto Reset Monitors", action = "auto" }
    end

    local picked = run_dmenu_entries(entries, "Display > ")
    if picked.action == "submenu-extend" then
        local extend_entries = {
            { label = string.format("󰍹  Extend Right  (%s → %s)", internal.name, ext.name), action = "extend-right" },
            { label = string.format("󰍹  Extend Left   (%s ← %s)", ext.name, internal.name), action = "extend-left" },
            { label = string.format("󰍹  Extend Above  (%s ↑ %s)", ext.name, internal.name), action = "extend-up" },
            { label = string.format("󰶐  External Only (%s)", ext.name), action = "external" },
            { label = string.format("󰌢  Laptop Only   (%s)", internal.name), action = "internal" },
            { label = "󰑓  Auto Reset All Monitors", action = "auto" },
        }
        picked = run_dmenu_entries(extend_entries, "Layout > ")
    end
    cmd = picked.action
    sub_arg = picked.arg
end

-- When running in --pick-only phase (holding display-menu.lock), finish any follow-up
-- workspace picker dmenu, then emit the concrete command JSON and exit to release the menu lock.
if pick_only then
    if (cmd == "present" or cmd == "switch-present" or cmd == "present-current") and (not sub_arg or sub_arg == "") then
        if not target_ext then
            io.stderr:write("kaze-display: no external monitor connected\n")
            notify("Present skipped", "No external monitor connected", "normal")
            os.exit(1)
        end
        local current_ws = (primary_phys and primary_phys.active_workspace) or (internal and internal.active_workspace) or nil
        local picked_ws, _, perr = pick_workspace_via_dmenu(
            "Present WS > ",
            current_ws,
            { state.present_workspace, state.virtual_workspace }
        )
        if picked_ws == nil then
            io.stderr:write("kaze-display: " .. tostring(perr) .. "\n")
            os.exit(1)
        end
        if picked_ws == "" then
            os.exit(0)
        end
        sub_arg = tostring(picked_ws)
    elseif cmd == "virtual-share-pick" then
        if not primary_phys then
            io.stderr:write("kaze-display: no physical monitor available\n")
            os.exit(1)
        end
        local current_ws = primary_phys.active_workspace
        local picked_ws, _, perr = pick_workspace_via_dmenu(
            "Virtual Share WS > ",
            current_ws,
            { state.present_workspace, state.virtual_workspace }
        )
        if picked_ws == nil then
            io.stderr:write("kaze-display: " .. tostring(perr) .. "\n")
            os.exit(1)
        end
        if picked_ws == "" then
            os.exit(0)
        end
        cmd = "virtual-share"
        sub_arg = tostring(picked_ws)
    elseif cmd == "switch-share" and (not sub_arg or sub_arg == "") then
        local share_mon = find_monitor_by_name(monitors, "kaze-share")
        if not share_mon and state.virtual_monitor ~= "kaze-share" then
            io.stderr:write("kaze-display: kaze-share is not active\n")
            os.exit(1)
        end
        local current_ws = primary_phys and primary_phys.active_workspace or nil
        local picked_ws, _, perr = pick_workspace_via_dmenu(
            "Virtual Share WS > ",
            current_ws,
            { state.present_workspace, state.virtual_workspace }
        )
        if picked_ws == nil then
            io.stderr:write("kaze-display: " .. tostring(perr) .. "\n")
            os.exit(1)
        end
        if picked_ws == "" then
            os.exit(0)
        end
        sub_arg = tostring(picked_ws)
    end
    io.stdout:write(json.encode({
        cmd = cmd,
        arg = sub_arg and tostring(sub_arg) or "",
        target = target_override or "",
    }) .. "\n")
    os.exit(0)
end

if cmd == "present" or cmd == "switch-present" or cmd == "present-current" then
    run_present(sub_arg, target_ext)
elseif cmd == "toggle-control" then
    run_toggle_control()
elseif cmd == "toggle-virtual-control" then
    run_toggle_virtual_control()
elseif cmd == "stop-present" then
    run_stop_present(false)
elseif cmd == "stop-mirror" then
    run_stop_present(true)
elseif cmd == "virtual-share" or cmd == "virtual-share-current" then
    run_virtual_share(sub_arg, false)
elseif cmd == "virtual-share-pick" then
    run_virtual_share(nil, true)
elseif cmd == "switch-share" then
    run_switch_share(sub_arg)
elseif cmd == "toggle-preview" then
    run_toggle_preview()
elseif cmd == "toggle-window-share" then
    run_toggle_window_share()
elseif cmd == "stop-virtual" then
    run_stop_virtual()
else
    run_standard_mode(cmd)
end
