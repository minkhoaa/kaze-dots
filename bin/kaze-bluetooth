#!/usr/bin/env lua

local script_dir

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local direct_base = script:match("^(.*)/[^/]+$")
    local direct_lua = direct_base and (direct_base .. "/../lua") or nil
    local f_direct = direct_lua and io.open(direct_lua .. "/kaze/defaults.lua", "r") or nil
    if f_direct then
        f_direct:close()
        script_dir = direct_base
        paths[#paths + 1] = direct_lua .. "/?.lua"
        paths[#paths + 1] = direct_lua .. "/?/init.lua"
    else
        local q = "'" .. script:gsub("'", "'\\''") .. "'"
        local p = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
        local resolved = p and p:read("*l") or nil
        if p then p:close() end
        script_dir = (resolved or script):match("^(.*)/[^/]+$")
        if script_dir then
            local repo_lua = script_dir .. "/../lua"
            local f = io.open(repo_lua .. "/kaze/defaults.lua", "r")
            if f then
                f:close()
                paths[#paths + 1] = repo_lua .. "/?.lua"
                paths[#paths + 1] = repo_lua .. "/?/init.lua"
            end
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
end

setup_path()

local fs = require("kaze.fs")
local notify_store = require("kaze.notify")
local popups = require("kaze.popups")

local function usage(out)
    (out or io.stdout):write("Usage: kaze-bluetooth [--list] [--scan] [--connect <MAC>] [--disconnect <MAC>] [--toggle-power]\n")
end

local function is_valid_mac(mac)
    if type(mac) ~= "string" then
        return false
    end
    return mac:match("^%x%x:%x%x:%x%x:%x%x:%x%x:%x%x$") ~= nil
end

local list_only = false
local do_scan = false
local connect_mac = nil
local disconnect_mac = nil
local toggle_power = false

local i = 1
while i <= #arg do
    local a = arg[i]
    if a == "-h" or a == "--help" then
        usage(io.stdout)
        os.exit(0)
    elseif a == "--list" then
        list_only = true
    elseif a == "--scan" then
        do_scan = true
    elseif a == "--toggle-power" then
        toggle_power = true
    elseif a == "--connect" then
        if not arg[i + 1] or arg[i + 1] == "" then
            io.stderr:write("kaze-bluetooth: --connect requires a MAC address\n")
            os.exit(2)
        end
        connect_mac = arg[i + 1]
        i = i + 1
    elseif a == "--disconnect" then
        if not arg[i + 1] or arg[i + 1] == "" then
            io.stderr:write("kaze-bluetooth: --disconnect requires a MAC address\n")
            os.exit(2)
        end
        disconnect_mac = arg[i + 1]
        i = i + 1
    else
        io.stderr:write(string.format("kaze-bluetooth: unknown option '%s'\n", tostring(a)))
        usage(io.stderr)
        os.exit(2)
    end
    i = i + 1
end

if connect_mac and not is_valid_mac(connect_mac) then
    io.stderr:write(string.format("kaze-bluetooth: invalid MAC address '%s'\n", tostring(connect_mac)))
    os.exit(1)
end
if disconnect_mac and not is_valid_mac(disconnect_mac) then
    io.stderr:write(string.format("kaze-bluetooth: invalid MAC address '%s'\n", tostring(disconnect_mac)))
    os.exit(1)
end

local function sibling_or_path(bin)
    if script_dir and fs.file_exists(script_dir .. "/" .. bin) then
        return script_dir .. "/" .. bin
    end
    return bin
end

local function notify(title, body, urgency)
    if not fs.command_exists("notify-send") then
        return
    end
    notify_store.record({
        app = "kaze-bluetooth",
        icon = "󰂯",
        urgency = urgency or "low",
        summary = title,
        body = body,
    })
    os.execute(string.format(
        "notify-send -a kaze-bluetooth -t 2200 -u %s -h string:x-canonical-private-synchronous:kaze-switch %s %s >/dev/null 2>&1 || true",
        urgency or "low",
        fs.shell_quote(title),
        fs.shell_quote(body)
    ))
end

local function ensure_bluetoothctl()
    if fs.command_exists("bluetoothctl") then
        return
    end
    notify("Bluetooth", "Install bluez-utils (bluetoothctl) for Bluetooth control", "normal")
    io.stderr:write("kaze-bluetooth: bluetoothctl not found in PATH\n")
    os.exit(1)
end

local function clean_label(s)
    return (tostring(s or ""):gsub("[\r\n\t]+", " "):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", ""))
end

local timeout_prefix = fs.command_exists("timeout") and "timeout 1.5s " or ""

local function btctl_capture(args)
    return fs.capture(timeout_prefix .. "bluetoothctl " .. args .. " </dev/null 2>/dev/null")
end

local function btctl_exec(args, wait_sec)
    local pfx = fs.command_exists("timeout") and string.format("timeout %ss ", tostring(wait_sec or 6)) or ""
    return os.execute(pfx .. "bluetoothctl " .. args .. " </dev/null >/dev/null 2>&1")
end

local function query_power()
    local show_out = btctl_capture("show")
    if not show_out or not show_out:find("Controller", 1, true) then
        return false, false
    end
    return true, show_out:find("Powered: yes", 1, true) ~= nil
end

local function parse_devices_output(raw, tbl)
    local out = tbl or {}
    for line in (raw or ""):gmatch("[^\r\n]+") do
        local mac, name = line:match("^%s*Device%s+(%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)%s*(.*)$")
        if mac then
            out[mac:upper()] = clean_label(name ~= "" and name or mac)
        end
    end
    return out
end

local function query_info(mac)
    local info = btctl_capture("info " .. fs.shell_quote(mac))
    if not info or info == "" then
        return {}
    end
    local bat = info:match("Battery Percentage:%s*0x%x+%s*%((%d+)%)")
        or info:match("Battery Percentage:%s*(%d+)%s*$")
    return {
        connected = info:find("Connected: yes", 1, true) ~= nil,
        paired = info:find("Paired: yes", 1, true) ~= nil,
        trusted = info:find("Trusted: yes", 1, true) ~= nil,
        battery = bat and tonumber(bat) or nil,
    }
end

local function probe_devices(powered)
    local all_map = parse_devices_output(btctl_capture("devices"))
    local connected_map = {}
    if powered then
        local conn_raw = btctl_capture("devices Connected")
        if conn_raw then
            parse_devices_output(conn_raw, connected_map)
        end
    end
    local paired_map = {}
    local paired_raw = btctl_capture("devices Paired")
        or btctl_capture("paired-devices")
    if paired_raw then
        parse_devices_output(paired_raw, paired_map)
    end

    local devices = {}
    for mac, name in pairs(all_map) do
        local info = query_info(mac)
        local is_conn = (connected_map[mac] ~= nil) or (info.connected == true)
        local is_paired = (paired_map[mac] ~= nil) or (info.paired == true)
        local bat = is_conn and info.battery or nil
        devices[#devices + 1] = {
            mac = mac,
            name = (name ~= "" and name or mac),
            connected = is_conn,
            paired = is_paired,
            trusted = info.trusted == true,
            battery = bat,
        }
    end

    table.sort(devices, function(a, b)
        if a.connected ~= b.connected then
            return a.connected
        end
        if a.paired ~= b.paired then
            return a.paired
        end
        local al, bl = a.name:lower(), b.name:lower()
        if al ~= bl then
            return al < bl
        end
        return a.mac < b.mac
    end)
    return devices
end

local function format_device_row(dev)
    local glyph = dev.connected and "󰂱" or "󰂯"
    local details = {}
    if dev.connected then
        details[#details + 1] = "connected"
        if dev.battery then
            details[#details + 1] = string.format("%d%%", dev.battery)
        end
    elseif not dev.paired then
        details[#details + 1] = "new"
    end
    local suffix = (#details > 0) and (" (" .. table.concat(details, ", ") .. ")") or ""
    return string.format("%s  %s%s", glyph, dev.name, suffix)
end

local function set_power(turn_on)
    local arg_str = turn_on and "on" or "off"
    local ok = btctl_exec("power " .. arg_str, 5)
    if ok == true or ok == 0 then
        notify("Bluetooth", turn_on and "Adapter powered on" or "Adapter powered off", "low")
        return true
    end
    notify("Bluetooth", "Failed to power " .. arg_str .. " adapter", "normal")
    return false
end

local function connect_device(mac, label_hint, paired_hint)
    local qmac = fs.shell_quote(mac)
    local name = label_hint or mac
    local known_paired = paired_hint
    if known_paired == nil then
        known_paired = query_info(mac).paired
    end
    if not known_paired then
        local ok_pair = btctl_exec("pair " .. qmac, 12)
        if not (ok_pair == true or ok_pair == 0) then
            notify("Bluetooth connection failed", "Could not pair " .. name, "normal")
            return false
        end
    end
    btctl_exec("trust " .. qmac, 5)
    local ok_conn = btctl_exec("connect " .. qmac, 12)
    if ok_conn == true or ok_conn == 0 then
        notify("Bluetooth connected", name, "low")
        return true
    end
    notify("Bluetooth connection failed", "Could not connect to " .. name, "normal")
    return false
end

local function disconnect_device(mac, label_hint)
    local qmac = fs.shell_quote(mac)
    local name = label_hint or mac
    local ok = btctl_exec("disconnect " .. qmac, 8)
    if ok == true or ok == 0 then
        notify("Bluetooth disconnected", name, "low")
        return true
    end
    notify("Bluetooth", "Could not disconnect " .. name, "normal")
    return false
end

ensure_bluetoothctl()

if toggle_power then
    local has_ctrl, powered = query_power()
    if not has_ctrl then
        notify("Bluetooth", "No Bluetooth adapter found", "normal")
        io.stderr:write("kaze-bluetooth: no Bluetooth controller available\n")
        os.exit(1)
    end
    os.exit(set_power(not powered) and 0 or 1)
end

if connect_mac then
    local mac = connect_mac:upper()
    local devices = probe_devices(true)
    local match_dev = nil
    for _, dev in ipairs(devices) do
        if dev.mac == mac then
            match_dev = dev
            break
        end
    end
    local _, powered = query_power()
    if not powered then
        set_power(true)
    end
    os.exit(connect_device(mac, match_dev and match_dev.name or mac, match_dev and match_dev.paired) and 0 or 1)
end

if disconnect_mac then
    local mac = disconnect_mac:upper()
    local devices = probe_devices(true)
    local label_hint = mac
    for _, dev in ipairs(devices) do
        if dev.mac == mac then
            label_hint = dev.name
            break
        end
    end
    os.exit(disconnect_device(mac, label_hint) and 0 or 1)
end

if not list_only and popups.toggle_existing_fuzzel("kaze-bluetooth") then
    os.exit(0)
end

if do_scan then
    local _, powered_for_scan = query_power()
    if powered_for_scan then
        btctl_exec("--timeout 5 scan on", 7)
    end
end

local has_ctrl, powered = query_power()
local devices = has_ctrl and probe_devices(powered) or {}

local rows = {}
local dev_by_row = {}
if has_ctrl and powered then
    local seen_rows = {}
    for _, dev in ipairs(devices) do
        local base = format_device_row(dev)
        local row = base
        if seen_rows[row] then
            row = base .. "  [" .. dev.mac .. "]"
        end
        seen_rows[row] = true
        rows[#rows + 1] = row
        dev_by_row[row] = dev
    end
end

if list_only then
    if not has_ctrl then
        io.stdout:write("󰂲  No Bluetooth controller found\n")
    elseif not powered then
        io.stdout:write("󰂲  Bluetooth is turned off\n")
    elseif #rows > 0 then
        io.stdout:write(table.concat(rows, "\n") .. "\n")
    end
    os.exit(0)
end

if not fs.command_exists("fuzzel") then
    io.stderr:write("kaze-bluetooth: fuzzel not found in PATH\n")
    os.exit(1)
end

local no_ctrl_row = "󰂲  No Bluetooth adapter found"
local power_on_row = "󰂯  Turn Bluetooth On"
local power_off_row = "󰂲  Turn Bluetooth Off"
local scan_row = "󰑐  Scan Bluetooth Devices (5s)"
local tui_row = "󰂯  Bluetooth Manager (bluetui)"

if not has_ctrl then
    rows[#rows + 1] = no_ctrl_row
elseif not powered then
    rows[#rows + 1] = power_on_row
    for _, dev in ipairs(devices) do
        if dev.paired then
            local row = format_device_row(dev)
            rows[#rows + 1] = row
            dev_by_row[row] = dev
        end
    end
else
    rows[#rows + 1] = scan_row
    rows[#rows + 1] = power_off_row
end

if fs.command_exists("bluetui") then
    rows[#rows + 1] = tui_row
end

local choice, dmenu_err = popups.run_dmenu(rows, {
    flags = popups.active_right_flags(),
    width = 52,
    lines = math.min(12, #rows),
    minimal_lines = true,
    line_height = 32,
    prompt = "Bluetooth > ",
    tag = "kaze-bluetooth",
})
if not choice then
    io.stderr:write("kaze-bluetooth: " .. tostring(dmenu_err) .. "\n")
    os.exit(1)
end
if choice == "" then
    os.exit(0)
end

if choice == no_ctrl_row then
    notify("Bluetooth", "No Bluetooth adapter found (check bluetooth.service or hardware)", "normal")
    os.exit(0)
elseif choice == power_on_row then
    os.exit(set_power(true) and 0 or 1)
elseif choice == power_off_row then
    os.exit(set_power(false) and 0 or 1)
elseif choice == scan_row then
    notify("Bluetooth", "Scanning for nearby devices (5s)...", "low")
    btctl_exec("--timeout 5 scan on", 7)
    local self_bin = arg and arg[0] or sibling_or_path("kaze-bluetooth")
    local ok_re = os.execute(fs.shell_quote(self_bin))
    os.exit((ok_re == true or ok_re == 0) and 0 or 1)
elseif choice == tui_row then
    local ok_tui = os.execute(fs.shell_quote(sibling_or_path("kaze-tui")) .. " bluetooth")
    os.exit((ok_tui == true or ok_tui == 0) and 0 or 1)
end

local target = dev_by_row[choice]
if not target then
    io.stderr:write("kaze-bluetooth: unrecognized selection\n")
    os.exit(1)
end

if target.connected then
    os.exit(disconnect_device(target.mac, target.name) and 0 or 1)
end

if not powered then
    if not set_power(true) then
        os.exit(1)
    end
end
os.exit(connect_device(target.mac, target.name, target.paired) and 0 or 1)
