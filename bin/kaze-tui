#!/usr/bin/env lua

local script_dir

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local q = "'" .. script:gsub("'", "'\\''") .. "'"
    local p = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
    local resolved = p and p:read("*l") or nil
    if p then
        p:close()
    end
    script_dir = (resolved or script):match("^(.*)/[^/]+$")
    if script_dir then
        local repo_lua = script_dir .. "/../lua"
        local f = io.open(repo_lua .. "/kaze/fs.lua", "r")
        if f then
            f:close()
            paths[#paths + 1] = repo_lua .. "/?.lua"
            paths[#paths + 1] = repo_lua .. "/?/init.lua"
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
end

setup_path()

local fs = require("kaze.fs")

local TOOLS = {
    wifi = {
        title = "Wi-Fi (nmtui)",
        candidates = { "impala", "nmtui" },
    },
    bluetooth = {
        title = "Bluetooth",
        candidates = { "bluetui", "bluetoothctl" },
    },
    audio = {
        title = "Audio Mixer",
        candidates = { "wiremix", "pulsemixer", "alsamixer" },
    },
    sysmon = {
        title = "System Monitor",
        candidates = { "btop", "htop", "top" },
    },
    mirror = {
        title = "Mirror Optimizer",
        app_id = "kaze-mirror-tui",
        candidates = { "kaze-mirror" },
        args = { "--tui" },
    },
}

local function cmd_exists(bin)
    local ok = os.execute("command -v " .. fs.shell_quote(bin) .. " >/dev/null 2>&1")
    return ok == true or ok == 0
end

local function sibling_or_path(bin)
    if script_dir and fs.file_exists(script_dir .. "/" .. bin) then
        return script_dir .. "/" .. bin
    end
    return bin
end

local function read_cmd(cmd)
    local p = io.popen(cmd)
    if not p then
        return ""
    end
    local out = p:read("*a") or ""
    p:close()
    return out
end

local function find_existing_tui(app_id, title)
    local hypr_sig = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
    if not hypr_sig or hypr_sig == "" then
        return nil, false
    end

    local active_out = read_cmd("hyprctl -j activewindow 2>/dev/null")
    local ok_act, parsed_act = pcall(require("kaze.json").decode, active_out)
    local active_addr = nil
    if ok_act and type(parsed_act) == "table" and type(parsed_act.address) == "string" then
        active_addr = parsed_act.address:gsub("^0x", "")
    else
        active_addr = active_out:match("Window%s+(%x+)%s+->")
    end

    local clients_out = read_cmd("hyprctl -j clients 2>/dev/null")
    local ok_cli, parsed_cli = pcall(require("kaze.json").decode, clients_out)
    if ok_cli and type(parsed_cli) == "table" then
        for _, c in ipairs(parsed_cli) do
            if type(c) == "table" and c.class == app_id and c.title == title and type(c.address) == "string" then
                local addr = c.address:gsub("^0x", "")
                return addr, addr == active_addr
            end
        end
        return nil, false
    end
    return nil, false
end

local mode = arg[1]
if mode == "-h" or mode == "--help" then
    io.stdout:write("Usage: kaze-tui <sysmon|mirror|wifi|bluetooth|audio>\n")
    os.exit(0)
end

if #arg > 1 then
    io.stderr:write("kaze-tui: too many arguments\n")
    os.exit(2)
end

local entry = TOOLS[mode]
if not entry then
    io.stderr:write(string.format(
        "kaze-tui: invalid mode '%s' (expected: sysmon, mirror, wifi, bluetooth, audio)\n",
        tostring(mode or "")
    ))
    os.exit(1)
end

local tool_bin
for _, cand in ipairs(entry.candidates) do
    local sib = sibling_or_path(cand)
    if sib ~= cand or cmd_exists(cand) then
        tool_bin = sib
        break
    end
end
if not tool_bin then
    io.stderr:write(string.format("kaze-tui: none of [%s] found in PATH\n", table.concat(entry.candidates, ", ")))
    os.exit(1)
end

local title = entry.title
local app_id = entry.app_id or "kaze-tui"
local existing_addr, is_active = find_existing_tui(app_id, title)
if existing_addr then
    local win_arg = "'address:0x" .. existing_addr .. "'"
    if is_active then
        os.execute("hyprctl dispatch " .. fs.shell_quote("hl.dsp.window.close({ window = " .. win_arg .. " })") .. " >/dev/null 2>&1")
    else
        os.execute("hyprctl dispatch " .. fs.shell_quote("hl.dsp.focus({ window = " .. win_arg .. " })") .. " >/dev/null 2>&1")
    end
    os.exit(0)
end

local footclient_bin = sibling_or_path("kaze-footclient")
local cmd_parts = {
    fs.shell_quote(footclient_bin),
    "-N",
    "-o",
    "main.locked-title=yes",
    "-a",
    fs.shell_quote(app_id),
    "-T",
    fs.shell_quote(title),
    fs.shell_quote(tool_bin),
}
for _, extra in ipairs(entry.args or {}) do
    cmd_parts[#cmd_parts + 1] = fs.shell_quote(extra)
end
local cmd = table.concat(cmd_parts, " ")
if not os.execute(cmd) then
    io.stderr:write("kaze-tui: could not open a window on the Kaze Foot server\n")
    os.exit(1)
end
