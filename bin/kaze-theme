#!/usr/bin/env lua

local script_dir

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local q = "'" .. script:gsub("'", "'\\''") .. "'"
    local p = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
    local resolved = p and p:read("*l") or nil
    if p then
        p:close()
    end
    script_dir = (resolved or script):match("^(.*)/[^/]+$")
    if script_dir then
        local repo_lua = script_dir .. "/../lua"
        local f = io.open(repo_lua .. "/kaze/defaults.lua", "r")
        if f then
            f:close()
            paths[#paths + 1] = repo_lua .. "/?.lua"
            paths[#paths + 1] = repo_lua .. "/?/init.lua"
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
end

setup_path()

local config = require("kaze.config")
local fs = require("kaze.fs")
local notify = require("kaze.notify")
local popups = require("kaze.popups")
local state = require("kaze.state")
local themes = require("kaze.themes")
local transaction = require("kaze.transaction")

local function cmd_exists(bin)
    local ok = os.execute("command -v " .. fs.shell_quote(bin) .. " >/dev/null 2>&1")
    return ok == true or ok == 0
end

local function sibling_or_path(bin)
    if script_dir and fs.file_exists(script_dir .. "/" .. bin) then
        return script_dir .. "/" .. bin
    end
    return bin
end

local function usage(output)
    (output or io.stdout):write(
        "Usage: kaze-theme [--quiet] [kaze|lavender|tokyonight|carbon|paper|dynamic|toggle-polarity|--menu|--current|-h|--help]\n"
    )
end

local function pick_from_menu(cur_cfg)
    if popups.toggle_existing_fuzzel("kaze-theme") then
        return nil
    end
    if not cmd_exists("fuzzel") then
        io.stderr:write("kaze-theme: fuzzel not found in PATH\n")
        os.exit(1)
    end

    local current_theme = cur_cfg.theme
    local st = state.load()
    local include_dynamic = cmd_exists("matugen") or current_theme == "dynamic"
    local dmenu_entries = {}
    local active_idx = nil
    for idx, name in ipairs(themes.list_selectable(include_dynamic)) do
        local label, icon
        if name == "dynamic" then
            label = "Dynamic (Wallpaper)"
            local dyn_pal = themes.get("kaze")
            if type(st.dynamic_palette) == "table" then
                local ok_dyn, parsed_dyn = pcall(themes.get, "dynamic", cur_cfg.theme_overrides, st.dynamic_palette)
                if ok_dyn then
                    dyn_pal = parsed_dyn
                end
            else
                local fallback_ok, cur_pal = pcall(themes.get, current_theme, cur_cfg.theme_overrides)
                if fallback_ok then
                    dyn_pal = {
                        bg_alt = cur_pal.bg_alt,
                        border = cur_pal.accent,
                        accent = "b4befe",
                        ok = cur_pal.ok,
                        warn = cur_pal.warn,
                        danger = cur_pal.danger,
                    }
                end
            end
            icon = popups.ensure_theme_swatch("dynamic", dyn_pal)
        else
            local pal = themes.get(name)
            label = pal.label
            icon = popups.ensure_theme_swatch(name, pal)
        end
        local marker = (name == current_theme) and " (active)" or ""
        dmenu_entries[#dmenu_entries + 1] = {
            text = string.format("%s  —  %s%s", name, label, marker),
            icon = icon,
        }
        if name == current_theme then
            active_idx = idx - 1
        end
    end

    local trimmed, dmenu_err = popups.run_dmenu(dmenu_entries, {
        flags = popups.active_right_flags(),
        width = 50,
        lines = #dmenu_entries,
        minimal_lines = true,
        hide_prompt = true,
        line_height = 36,
        image_size_ratio = 0.72,
        select_index = active_idx,
        prompt = "Theme > ",
        tag = "kaze-theme",
    })
    if not trimmed then
        io.stderr:write("kaze-theme: " .. tostring(dmenu_err) .. "\n")
        os.exit(1)
    end
    if trimmed == "" then
        return nil
    end
    return trimmed:match("^(%S+)")
end

local quiet = false
local mode = nil
for i = 1, #arg do
    local a = arg[i]
    if a == "-q" or a == "--quiet" then
        quiet = true
    elseif a == "-h" or a == "--help" then
        usage(io.stdout)
        os.exit(0)
    elseif mode == nil then
        mode = a
    else
        io.stderr:write("kaze-theme: too many arguments\n")
        usage(io.stderr)
        os.exit(2)
    end
end

if mode == "--current" then
    io.stdout:write(config.load({ strict = false }).theme .. "\n")
    os.exit(0)
end

local target = mode
if not target or target == "--menu" then
    target = pick_from_menu(config.load({ strict = false }))
    if not target then
        os.exit(0)
    end
elseif target:sub(1, 1) == "-" then
    io.stderr:write(string.format("kaze-theme: unknown option '%s'\n", target))
    usage(io.stderr)
    os.exit(2)
end

local sync_bin = sibling_or_path("kaze-sync")
local label

local reuse_cached_dynamic = false
if target == "toggle-polarity" then
    local cur_cfg = config.load({ strict = false })
    if cur_cfg.theme == "paper" then
        local st = state.load()
        local prev_dark = st.last_dark_theme or "kaze"
        if prev_dark == "dynamic" then
            if st.dynamic_palette ~= nil then
                reuse_cached_dynamic = true
            elseif not cmd_exists("matugen") then
                prev_dark = "kaze"
            end
        end
        target = prev_dark
    else
        target = "paper"
    end
end

if target == "dynamic" then
    if config.user_overrides().theme ~= nil then
        io.stderr:write("kaze-theme: theme is pinned by user.lua\n")
        os.exit(1)
    end
    if reuse_cached_dynamic then
        if not os.execute(fs.shell_quote(sync_bin) .. " --set-theme dynamic") then
            io.stderr:write("kaze-theme: dynamic theme switch failed\n")
            os.exit(1)
        end
    else
        if not cmd_exists("matugen") then
            io.stderr:write("kaze-theme: matugen not found in PATH\n")
            os.exit(1)
        end
        local cur_cfg = config.load({ strict = false })
        local ok_wall, wall_err = transaction.validate_wallpaper(cur_cfg.wallpaper_expanded)
        if not ok_wall then
            io.stderr:write("kaze-theme: " .. tostring(wall_err) .. "\n")
            os.exit(1)
        end
        if not os.execute(fs.shell_quote(sync_bin) .. " --set-dynamic-theme") then
            io.stderr:write("kaze-theme: dynamic theme switch failed\n")
            os.exit(1)
        end
    end
    label = "Dynamic (Wallpaper)"
else
    local ok_theme, theme = pcall(themes.get, target)
    if not ok_theme then
        io.stderr:write(string.format("kaze-theme: %s\n", tostring(theme)))
        os.exit(1)
    end
    if not os.execute(fs.shell_quote(sync_bin) .. " --set-theme " .. fs.shell_quote(theme.name)) then
        io.stderr:write("kaze-theme: switch failed\n")
        os.exit(1)
    end
    label = theme.label
end

local hypr_sig = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
local wl_disp = os.getenv("WAYLAND_DISPLAY")
if not quiet and ((hypr_sig and hypr_sig ~= "") or (wl_disp and wl_disp ~= "")) and cmd_exists("notify-send") then
    notify.record({
        app = "kaze-theme",
        icon = "󰏘",
        urgency = "low",
        summary = "Theme switched",
        body = "Active: " .. label,
    })
    os.execute(string.format(
        "notify-send -a kaze-theme -t 1800 -u low -h string:x-canonical-private-synchronous:kaze-switch %s %s >/dev/null 2>&1 || true",
        fs.shell_quote("Theme switched"),
        fs.shell_quote("Active: " .. label)
    ))
end
