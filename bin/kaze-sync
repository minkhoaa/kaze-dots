#!/usr/bin/env lua

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local q = "'" .. script:gsub("'", "'\\''") .. "'"
    local p = io.popen("readlink -f " .. q .. " 2>/dev/null")
    local resolved = p and p:read("*l") or nil
    if p then
        p:close()
    end
    local base = (resolved or script):match("^(.*)/[^/]+$")
    if base then
        local repo_lua = base .. "/../lua"
        local f = io.open(repo_lua .. "/kaze/defaults.lua", "r")
        if f then
            f:close()
            paths[#paths + 1] = repo_lua .. "/?.lua"
            paths[#paths + 1] = repo_lua .. "/?/init.lua"
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
end

setup_path()

local config = require("kaze.config")
local emit_fnott = require("kaze.emit_fnott")
local emit_foot = require("kaze.emit_foot")
local emit_fuzzel = require("kaze.emit_fuzzel")
local emit_hyprlock = require("kaze.emit_hyprlock")
local emit_waybar = require("kaze.emit_waybar")
local fs = require("kaze.fs")
local session = require("kaze.session")
local state = require("kaze.state")
local transaction = require("kaze.transaction")

local function usage(output)
    output:write("Usage: kaze-sync [--reload | --check | --session-start | --set-layout NAME | --set-theme NAME]\n")
end

local option, value = arg[1], arg[2]
local check_only = option == "--check"
local session_start = option == "--session-start"
local setting = ({ ["--set-layout"] = "layout", ["--set-theme"] = "theme" })[option]
local do_reload = option == "--reload" or setting ~= nil
if #arg == 1 and (option == "-h" or option == "--help") then
    usage(io.stdout)
    os.exit(0)
end
if (setting and (#arg ~= 2 or value == ""))
    or (not setting and (#arg > 1 or (option and not (check_only or session_start or do_reload)))) then
    usage(io.stderr)
    os.exit(2)
end

local function fail(err)
    io.stderr:write("kaze-sync: " .. tostring(err) .. "\n")
    os.exit(1)
end

local signature = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
local live = do_reload and signature and signature ~= ""
local work_dir
if not check_only then
    work_dir = fs.private_runtime_dir()
    if not work_dir then
        if live or session_start or fs.runtime_dir() then fail("cannot prepare $XDG_RUNTIME_DIR/kaze") end
        work_dir = fs.config_dir() .. "/kaze"
        fs.mkdir_p(work_dir)
    end
    if os.getenv("KAZE_SYNC_LOCKED") ~= "1" then
        local args = { fs.shell_quote(arg[0]) }
        for _, a in ipairs(arg) do args[#args + 1] = fs.shell_quote(a) end
        os.exit(fs.exit_status(os.execute("umask 077; exec flock --close " .. fs.shell_quote(work_dir .. "/sync.lock")
            .. " env KAZE_SYNC_LOCKED=1 " .. table.concat(args, " "))))
    end
end

local pending
if live then
    if not session.is_active() then fail("no active Kaze session; start a new Hyprland login after apply.sh") end
    pending = state.pending_path()
    if not pending or not os.execute("[ -d " .. fs.shell_quote(fs.dirname(pending)) .. " ]") then
        fail("Hyprland instance directory not found")
    end
end

local candidate
if setting then
    candidate = state.load()
    candidate[setting] = value
end
local ok, cfg, theme, layout = pcall(config.load, { strict = not session_start, state = candidate })
if not ok then fail(cfg) end
if setting and cfg[setting] ~= value then fail(setting .. " is pinned by user.lua") end

local waybar = emit_waybar.emit(cfg, theme, layout)
local foot_ini = emit_foot.emit(cfg, theme, layout)
local fuzzel_ini = emit_fuzzel.emit(cfg, theme, layout)
local fnott_ini = emit_fnott.emit(cfg, theme, layout)
local hyprlock_conf = emit_hyprlock.emit(cfg, theme, layout)

if check_only then
    io.stdout:write(string.format("kaze-sync: check ok (layout=%s, theme=%s)\n", cfg.layout, cfg.theme))
    os.exit(0)
end

local cfg_dir = fs.config_dir()
local outputs = {
    { cfg_dir .. "/waybar/colors.css", waybar.colors_css },
    { cfg_dir .. "/waybar/config.jsonc", waybar.config_jsonc },
    { cfg_dir .. "/waybar/style.css", waybar.style_css },
    { cfg_dir .. "/foot/foot.ini", foot_ini, "foot --check-config -c" },
    { cfg_dir .. "/fuzzel/fuzzel.ini", fuzzel_ini, "fuzzel --check-config --config" },
    { cfg_dir .. "/fnott/fnott.ini", fnott_ini },
    { cfg_dir .. "/hypr/hyprlock.conf", hyprlock_conf },
}

local appearance
if live or session_start then
    local env_path = work_dir .. "/session.env"
    local env_ok, contents, change = pcall(function()
        local previous = live and assert(fs.read_file(env_path), "missing session.env; start a new Kaze login") or nil
        local next_env = session.render_environment(cfg, theme, previous)
        if previous then
            return next_env, { before = session.read_appearance(previous), after = session.read_appearance(next_env) }
        end
        return next_env
    end)
    if not env_ok then fail(contents) end
    outputs[#outputs + 1] = { env_path, contents }
    appearance = change
end

local applied, err = transaction.apply(outputs, {
    live = live,
    appearance = appearance,
    candidate = candidate,
    pending = pending,
    work_dir = work_dir,
})
if not applied then fail(err) end
