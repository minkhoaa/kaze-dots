#!/usr/bin/env lua

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local q = "'" .. script:gsub("'", "'\\''") .. "'"
    local p = io.popen("readlink -f " .. q .. " 2>/dev/null")
    local resolved = p and p:read("*l") or nil
    if p then
        p:close()
    end
    local base = (resolved or script):match("^(.*)/[^/]+$")
    if base then
        local repo_lua = base .. "/../lua"
        local f = io.open(repo_lua .. "/kaze/defaults.lua", "r")
        if f then
            f:close()
            paths[#paths + 1] = repo_lua .. "/?.lua"
            paths[#paths + 1] = repo_lua .. "/?/init.lua"
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
end

setup_path()

local config = require("kaze.config")
local emit_fnott = require("kaze.emit_fnott")
local emit_foot = require("kaze.emit_foot")
local emit_fuzzel = require("kaze.emit_fuzzel")
local emit_hyprlock = require("kaze.emit_hyprlock")
local emit_waybar = require("kaze.emit_waybar")
local fs = require("kaze.fs")

local function usage()
    io.stderr:write("Usage: kaze-sync [--reload] [--check] [-h|--help]\n")
end

local check_only = false
local do_reload = false

for i = 1, #arg do
    local a = arg[i]
    if a == "--check" then
        check_only = true
    elseif a == "--reload" then
        do_reload = true
    elseif a == "-h" or a == "--help" then
        io.stdout:write("Usage: kaze-sync [--reload] [--check] [-h|--help]\n")
        os.exit(0)
    else
        io.stderr:write(string.format("kaze-sync: unknown option '%s'\n", a))
        usage()
        os.exit(2)
    end
end

local ok, cfg, theme, layout = pcall(config.load, { strict = true })
if not ok then
    io.stderr:write(string.format("kaze-sync: %s\n", tostring(cfg)))
    os.exit(1)
end

local waybar = emit_waybar.emit(cfg, theme, layout)
local foot_ini = emit_foot.emit(cfg, theme, layout)
local fuzzel_ini = emit_fuzzel.emit(cfg, theme, layout)
local fnott_ini = emit_fnott.emit(cfg, theme, layout)
local hyprlock_conf = emit_hyprlock.emit(cfg, theme, layout)

if check_only then
    io.stdout:write(string.format("kaze-sync: check ok (layout=%s, theme=%s)\n", cfg.layout, cfg.theme))
    os.exit(0)
end

local cfg_dir = fs.config_dir()
local outputs = {
    { cfg_dir .. "/waybar/colors.css", waybar.colors_css },
    { cfg_dir .. "/waybar/config.jsonc", waybar.config_jsonc },
    { cfg_dir .. "/waybar/style.css", waybar.style_css },
    { cfg_dir .. "/foot/foot.ini", foot_ini },
    { cfg_dir .. "/fuzzel/fuzzel.ini", fuzzel_ini },
    { cfg_dir .. "/fnott/fnott.ini", fnott_ini },
    { cfg_dir .. "/hypr/hyprlock.conf", hyprlock_conf },
}

for _, item in ipairs(outputs) do
    local write_ok, write_err = pcall(fs.write_atomic, item[1], item[2])
    if not write_ok then
        io.stderr:write(string.format("kaze-sync: %s\n", tostring(write_err)))
        os.exit(1)
    end
end

if do_reload then
    local hypr_sig = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
    local wl_disp = os.getenv("WAYLAND_DISPLAY")
    local has_hypr = hypr_sig and hypr_sig ~= ""
    local has_wayland = (wl_disp and wl_disp ~= "") or has_hypr

    if has_hypr then
        os.execute("hyprctl reload >/dev/null 2>&1")
    end

    if has_wayland then
        local utf8_guard = "case \"${LC_ALL:-${LC_CTYPE:-${LANG:-C}}}\" in *.UTF-8*|*.utf8*) ;; *) export LC_CTYPE=C.UTF-8 ;; esac; "
        os.execute(
            utf8_guard
                .. "pkill -x waybar >/dev/null 2>&1 || true; "
                .. "i=0; while pgrep -x waybar >/dev/null 2>&1 && [ \"$i\" -lt 15 ]; do sleep 0.02; i=$((i + 1)); done; "
                .. "nohup waybar >/dev/null 2>&1 </dev/null &"
        )
        os.execute(
            utf8_guard
                .. "pkill -x fnott >/dev/null 2>&1 || true; "
                .. "i=0; while pgrep -x fnott >/dev/null 2>&1 && [ \"$i\" -lt 10 ]; do sleep 0.02; i=$((i + 1)); done; "
                .. "nohup fnott >/dev/null 2>&1 </dev/null &"
        )
    end
end
