#!/usr/bin/env lua

local script_dir

local function setup_path()
    local home = os.getenv("HOME") or ""
    local xdg_data = os.getenv("XDG_DATA_HOME")
    if not xdg_data or xdg_data == "" then
        xdg_data = home .. "/.local/share"
    end
    local paths = {}
    local script = arg and arg[0] or ""
    local q = "'" .. script:gsub("'", "'\\''") .. "'"
    local p = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
    local resolved = p and p:read("*l") or nil
    if p then
        p:close()
    end
    script_dir = (resolved or script):match("^(.*)/[^/]+$")
    if script_dir then
        local repo_lua = script_dir .. "/../lua"
        local f = io.open(repo_lua .. "/kaze/defaults.lua", "r")
        if f then
            f:close()
            paths[#paths + 1] = repo_lua .. "/?.lua"
            paths[#paths + 1] = repo_lua .. "/?/init.lua"
        end
    end
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?.lua"
    paths[#paths + 1] = xdg_data .. "/kaze-dots/lua/?/init.lua"
    paths[#paths + 1] = package.path
    package.path = table.concat(paths, ";")
end

setup_path()

local config = require("kaze.config")
local fs = require("kaze.fs")
local popups = require("kaze.popups")
local transaction = require("kaze.transaction")

local function cmd_exists(bin)
    local ok = os.execute("command -v " .. fs.shell_quote(bin) .. " >/dev/null 2>&1")
    return ok == true or ok == 0
end

local function sibling_or_path(bin)
    if script_dir and fs.file_exists(script_dir .. "/" .. bin) then
        return script_dir .. "/" .. bin
    end
    return bin
end

local function usage(output)
    (output or io.stdout):write(
        "Usage: kaze-wall [--quiet] [<path> | --random | --menu | --preview | --current | -h | --help]\n"
    )
end

local function fail(msg, code)
    io.stderr:write("kaze-wall: " .. tostring(msg) .. "\n")
    os.exit(code or 1)
end

local function seed_rng()
    local urnd = io.open("/dev/urandom", "rb")
    if urnd then
        local bytes = urnd:read(4)
        urnd:close()
        if bytes and #bytes == 4 then
            local b1, b2, b3, b4 = bytes:byte(1, 4)
            local seed = ((b1 * 256 + b2) * 256 + b3) * 256 + b4
            math.randomseed(seed)
            return
        end
    end
    math.randomseed(os.time() + math.floor(os.clock() * 1000000))
end

local function canonicalize(path)
    local expanded = fs.expand_home(path)
    if expanded:sub(1, 1) ~= "/" then
        local cwd = fs.capture("pwd")
        cwd = cwd and cwd:gsub("\n$", "") or "."
        expanded = cwd .. "/" .. expanded
    end
    local resolved = fs.capture("readlink -f -- " .. fs.shell_quote(expanded) .. " 2>/dev/null")
    if resolved and resolved ~= "" then
        return resolved:gsub("\n$", "")
    end
    return expanded
end

local function is_supported_ext(path)
    local lower = path:lower()
    return lower:match("%.png$") ~= nil
        or lower:match("%.jpg$") ~= nil
        or lower:match("%.jpeg$") ~= nil
        or lower:match("%.webp$") ~= nil
end

local function scan_wallpapers(wall_dir)
    local clean_dir = wall_dir:gsub("/+$", "")
    if clean_dir == "" then
        clean_dir = "/"
    end
    if not os.execute("[ -d " .. fs.shell_quote(clean_dir) .. " ]") then
        fail("wallpaper directory not found: " .. clean_dir)
    end
    local p = io.popen("find -L " .. fs.shell_quote(clean_dir) .. " -type f -print0 2>/dev/null", "r")
    if not p then
        fail("failed to scan wallpaper directory: " .. clean_dir)
    end
    local raw = p:read("*a") or ""
    p:close()

    local entries = {}
    local prefix_len = (clean_dir == "/") and 1 or (#clean_dir + 1)
    for full in raw:gmatch("([^%z]+)%z") do
        if is_supported_ext(full) then
            local rel = full:sub(prefix_len + 1)
            if rel ~= "" then
                entries[#entries + 1] = {
                    rel = rel,
                    full = full,
                }
            end
        end
    end
    table.sort(entries, function(a, b)
        return a.rel < b.rel
    end)
    return entries
end

local function pick_from_menu(wall_dir)
    local running = os.execute("pgrep -x fuzzel >/dev/null 2>&1")
    if running == true or running == 0 then
        os.execute("pkill -x fuzzel >/dev/null 2>&1")
        return nil
    end
    if not cmd_exists("fuzzel") then
        fail("fuzzel not found in PATH")
    end

    local entries = scan_wallpapers(wall_dir)
    if #entries == 0 then
        fail("no wallpapers found in " .. wall_dir)
    end

    local lines = {}
    local by_rel = {}
    for _, e in ipairs(entries) do
        lines[#lines + 1] = e.rel
        by_rel[e.rel] = e.full
    end

    local utf8_guard = "case \"${LC_ALL:-${LC_CTYPE:-${LANG:-C}}}\" in *.UTF-8*|*.utf8*) ;; *) export LC_CTYPE=C.UTF-8 ;; esac; "
    local cmd = string.format(
        "%sprintf '%%s\\n' %s | fuzzel --dmenu %s -w 44 --lines %d -p %s",
        utf8_guard,
        fs.shell_quote(table.concat(lines, "\n")),
        popups.active_right_flags(),
        math.min(#lines, 12),
        fs.shell_quote("Wallpaper > ")
    )
    local p = io.popen(cmd)
    if not p then
        fail("failed to launch fuzzel")
    end
    local out = p:read("*a") or ""
    p:close()
    local selected = out:gsub("[\r\n]+$", "")
    if selected == "" then
        return nil
    end
    local chosen = by_rel[selected]
    if not chosen then
        fail("unknown wallpaper selection: " .. selected)
    end
    return chosen
end

local quiet = false
local mode = nil
for i = 1, #arg do
    local a = arg[i]
    if a == "-q" or a == "--quiet" then
        quiet = true
    elseif a == "-h" or a == "--help" then
        usage(io.stdout)
        os.exit(0)
    elseif mode == nil then
        mode = a
    else
        io.stderr:write("kaze-wall: too many arguments\n")
        usage(io.stderr)
        os.exit(2)
    end
end

local cfg = config.load({ strict = false })
local wall_dir = fs.expand_home(cfg.wallpaper_dir or "~/Pictures/Wallpapers")

if mode == "--current" then
    io.stdout:write((cfg.wallpaper_expanded or "") .. "\n")
    os.exit(0)
end

if mode == "--preview" then
    if not cmd_exists("yazi") then
        fail("yazi not found in PATH")
    end
    if not os.execute("[ -d " .. fs.shell_quote(wall_dir) .. " ]") then
        fail("wallpaper directory not found: " .. wall_dir)
    end
    local foot_bin = sibling_or_path("kaze-footclient")
    local cmd = string.format(
        "%s -a kaze-tui -T %s yazi %s",
        fs.shell_quote(foot_bin),
        fs.shell_quote("Wallpapers (yazi)"),
        fs.shell_quote(wall_dir)
    )
    os.exit(fs.exit_status(os.execute(cmd)))
end

if mode and mode:sub(1, 1) == "-" and mode ~= "--menu" and mode ~= "--random" then
    io.stderr:write(string.format("kaze-wall: unknown option '%s'\n", mode))
    usage(io.stderr)
    os.exit(2)
end

if config.user_overrides().wallpaper ~= nil then
    fail("wallpaper is pinned by user.lua")
end

local target_path
if not mode or mode == "--menu" then
    target_path = pick_from_menu(wall_dir)
    if not target_path then
        os.exit(0)
    end
elseif mode == "--random" then
    local entries = scan_wallpapers(wall_dir)
    if #entries == 0 then
        fail("no wallpapers found in " .. wall_dir)
    end
    seed_rng()
    local cur_canon = cfg.wallpaper_expanded and canonicalize(cfg.wallpaper_expanded) or ""
    local pool = {}
    if #entries > 1 then
        for _, e in ipairs(entries) do
            if canonicalize(e.full) ~= cur_canon then
                pool[#pool + 1] = e.full
            end
        end
    end
    if #pool == 0 then
        for _, e in ipairs(entries) do
            pool[#pool + 1] = e.full
        end
    end
    target_path = pool[math.random(1, #pool)]
else
    target_path = canonicalize(mode)
end

local ok_wall, wall_err = transaction.validate_wallpaper(target_path)
if not ok_wall then
    fail(wall_err)
end

local sync_bin = sibling_or_path("kaze-sync")
local sync_cmd = fs.shell_quote(sync_bin) .. " --set-wallpaper " .. fs.shell_quote(target_path)
local work_dir = fs.private_runtime_dir()
if work_dir and cmd_exists("flock") then
    sync_cmd = "umask 077; flock --close " .. fs.shell_quote(work_dir .. "/wall.lock") .. " " .. sync_cmd
end

if not os.execute(sync_cmd) then
    fail("wallpaper switch failed")
end

local hypr_sig = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
local wl_disp = os.getenv("WAYLAND_DISPLAY")
if not quiet and ((hypr_sig and hypr_sig ~= "") or (wl_disp and wl_disp ~= "")) and cmd_exists("notify-send") then
    local basename = target_path:match("([^/]+)$") or target_path
    os.execute(string.format(
        "notify-send -a kaze-wall -t 1800 -u low -h string:x-canonical-private-synchronous:kaze-switch %s %s >/dev/null 2>&1 || true",
        fs.shell_quote("Wallpaper switched"),
        fs.shell_quote("Active: " .. basename)
    ))
end
