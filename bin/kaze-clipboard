#!/usr/bin/env lua

local action = arg[1] or "pick"
if #arg > 1 or not ({ pick = true, list = true, store = true, wipe = true })[action] then
    local help = #arg == 1 and (action == "--help" or action == "-h")
    local stream = help and io.stdout or io.stderr
    stream:write("Usage: kaze-clipboard [pick|list|store|wipe]\n")
    os.exit(help and 0 or 2)
end

-- Reject unknown states too: this must only store wl-paste events marked as data.
if action == "store" and os.getenv("CLIPBOARD_STATE") ~= "data" then os.exit(0) end

local script = arg and arg[0] or ""
local data_home = os.getenv("XDG_DATA_HOME") or ""
if data_home == "" then data_home = (os.getenv("HOME") or "") .. "/.local/share" end
local installed = data_home .. "/kaze-dots/lua"
local direct_dir = script:match("^(.*)/[^/]+$")
local repo = direct_dir and (direct_dir .. "/../lua") or nil
local f_repo = repo and io.open(repo .. "/kaze/defaults.lua", "r") or nil
if f_repo then
    f_repo:close()
else
    local f_inst = io.open(installed .. "/kaze/defaults.lua", "r")
    if f_inst then
        f_inst:close()
        repo = nil
    else
        local q = "'" .. script:gsub("'", "'\\''") .. "'"
        local link = io.popen("(readlink -f -- " .. q .. " || /usr/bin/readlink -f -- " .. q .. ") 2>/dev/null")
        local resolved = link and link:read("*l")
        if link then link:close() end
        repo = ((resolved or script):match("^(.*)/[^/]+$") or ".") .. "/../lua"
    end
end
local paths = {}
if repo then
    paths[#paths + 1] = repo .. "/?.lua"
    paths[#paths + 1] = repo .. "/?/init.lua"
end
paths[#paths + 1] = installed .. "/?.lua"
paths[#paths + 1] = installed .. "/?/init.lua"
paths[#paths + 1] = package.path
package.path = table.concat(paths, ";")

local cfg = require("kaze.config").load({ strict = false })
local fs = require("kaze.fs")
local quote = fs.shell_quote

local function fail(msg)
    io.stderr:write("kaze-clipboard: " .. msg .. "\n")
    os.exit(1)
end

local clipboard = cfg.clipboard
local function positive_integer(n, limit)
    return type(n) == "number" and math.tointeger(n) and n >= 1 and n <= limit
end
if type(clipboard) ~= "table" or type(clipboard.ephemeral) ~= "boolean"
    or not positive_integer(clipboard.max_items, 750)
    or not positive_integer(clipboard.max_bytes, 64 * 1024 * 1024) then
    fail("invalid clipboard settings (max_items: 1–750, max_bytes: 1–67108864)")
end

local input
if action == "store" then
    -- Avoid stdio read-ahead past the byte budget. Exiting closes the pipe on oversize.
    io.stdin:setvbuf("no")
    local read_err
    input, read_err = io.stdin:read(clipboard.max_bytes + 1)
    if read_err then fail(read_err) end
    if not input or #input == 0 or #input > clipboard.max_bytes then os.exit(0) end
end

local db
if clipboard.ephemeral then
    local dir = fs.private_runtime_dir()
    if not dir then fail("cannot prepare $XDG_RUNTIME_DIR/kaze") end
    db = dir .. "/cliphist.db"
    if not os.execute("[ ! -L " .. quote(db) .. " ] && [ ! -L " .. quote(db .. ".tmp") .. " ]") then
        fail("refusing symlink at the session database path")
    end
else
    db = fs.cache_dir() .. "/cliphist/db"
end

-- Do not let a separate cliphist/config override the DB and limits for these calls.
local cliphist = string.format("umask 077; exec cliphist -config-path /dev/null -db-path %s -max-items %d ",
    quote(db), clipboard.max_items)

if action == "store" then
    local proc = io.popen(cliphist .. "store", "w")
    if not proc then fail("cannot launch cliphist store") end
    local written = proc:write(input)
    local ok = proc:close()
    if not (written and ok) then fail("cliphist store failed") end
    os.exit(0)
end

-- With no DB there is no history to list, pick or wipe.
if not fs.file_exists(db) then os.exit(0) end
if action == "list" or action == "wipe" then
    if not os.execute(cliphist .. action) then fail("cliphist " .. action .. " failed") end
    os.exit(0)
end

if not os.execute("command -v cliphist >/dev/null && command -v fuzzel >/dev/null && command -v wl-copy >/dev/null") then
    fail("pick requires cliphist, fuzzel and wl-copy")
end
local selected = fs.capture("bash -o pipefail -c " .. quote(cliphist .. "list | fuzzel --dmenu -p 'Clip > '"))
if not selected then os.exit(0) end
selected = selected:gsub("\n$", "")
if not selected:match("^%d+\t") then os.exit(0) end

-- Decode completely before opening wl-copy; deleted/stale selection must be a no-op.
local data = fs.capture(cliphist .. "decode " .. quote(selected))
if not data or data == "" then fail("clipboard entry could not be decoded") end
-- wl-copy uses xdg-mime for other formats. Do not depend on that path for PNGs, JPEGs, WebPs, or GIFs.
local mime = ""
if data:sub(1, 8) == "\137PNG\r\n\26\n" then
    mime = " --type image/png"
elseif #data >= 4 and data:sub(1, 3) == "\255\216\255" then
    mime = " --type image/jpeg"
elseif #data >= 12 and data:sub(1, 4) == "RIFF" and data:sub(9, 12) == "WEBP" then
    mime = " --type image/webp"
elseif data:sub(1, 6) == "GIF87a" or data:sub(1, 6) == "GIF89a" then
    mime = " --type image/gif"
end
local copy = io.popen("exec wl-copy" .. mime .. " >/dev/null 2>&1", "w")
if not copy then fail("cannot launch wl-copy") end
local written = copy:write(data)
local ok = copy:close()
if not (written and ok) then fail("wl-copy failed") end
