-- User overrides for kaze-dots (~/.config/kaze/user.lua)
-- This file is created once by scripts/apply.sh and never overwritten.
-- Active layout and theme are normally persisted in ~/.config/kaze/state.lua
-- via `kaze-layout` and `kaze-theme` (uncommenting `layout` or `theme` below
-- will pin them and override state.lua).

return {
