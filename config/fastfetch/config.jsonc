{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "title": "cyan",
      "keys": "blue",
      "separator": "dim_white"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#dim_white}┌─{#} {user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "os",
      "key": "{#dim_white}│{#} {#cyan}󰣇 OS    {#}",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "{#dim_white}│{#} {#cyan}󰒋 Kernel{#}",
      "format": "{release}"
    },
    {
      "type": "packages",
      "key": "{#dim_white}│{#} {#cyan}󰏖 Pkgs  {#}"
    },
    {
      "type": "uptime",
      "key": "{#dim_white}│{#} {#cyan}󰅐 Uptime{#}"
    },
    {
      "type": "custom",
      "format": "{#dim_white}├──────────────────────────────────────────{#}"
    },
    {
      "type": "wm",
      "key": "{#dim_white}│{#} {#magenta}󱂬 WM    {#}",
      "format": "{pretty-name}{?version} {version}{?}"
    },
    {
      "type": "shell",
      "key": "{#dim_white}│{#} {#magenta}󰆍 Shell {#}",
      "format": "{pretty-name}{?version} {version}{?}"
    },
    {
      "type": "terminal",
      "key": "{#dim_white}│{#} {#magenta}󰞷 Term  {#}",
      "format": "{pretty-name}{?version} {version}{?}"
    },
    {
      "type": "custom",
      "format": "{#dim_white}├──────────────────────────────────────────{#}"
    },
    {
      "type": "cpu",
      "key": "{#dim_white}│{#} {#green}󰻠 CPU   {#}",
      "format": "{name} ({cores-logical})"
    },
    {
      "type": "gpu",
      "key": "{#dim_white}│{#} {#green}󰢮 GPU   {#}",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#dim_white}│{#} {#yellow}󰍛 Memory{#}"
    },
    {
      "type": "disk",
      "key": "{#dim_white}│{#} {#yellow}󰋊 Disk  {#}",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "{#dim_white}└──────────────────────────────────────────{#}"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
