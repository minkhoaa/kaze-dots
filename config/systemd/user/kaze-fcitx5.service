[Unit]
Description=Kaze Fcitx5 input method daemon
PartOf=kaze-session.target
Requisite=kaze-session.target
After=kaze-session.target
ConditionFileIsExecutable=/usr/bin/fcitx5
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=exec
EnvironmentFile=%t/kaze/session.env
ExecCondition=:/usr/bin/sh -c 'test "${KAZE_ENABLE_FCITX5:-0}" = 1'
ExecStartPre=:/usr/bin/sh -c 'cfg="${XDG_CONFIG_HOME:-$HOME/.config}/fcitx5/profile"; if [ ! -e "$cfg" ] && [ ! -L "$cfg" ]; then mkdir -p -- "$(dirname -- "$cfg")" && tmp=$(mktemp -- "$cfg.XXXXXXXX") && printf "%%s\\n" "[Groups/0]" "Name=Default" "Default Layout=us" "DefaultIM=bamboo" "" "[Groups/0/Items/0]" "Name=keyboard-us" "Layout=" "" "[Groups/0/Items/1]" "Name=bamboo" "Layout=" "" "[GroupOrder]" "0=Default" > "$tmp" && mv -f -- "$tmp" "$cfg"; fi'
ExecStart=/usr/bin/fcitx5
Restart=on-failure
RestartSec=250ms
TimeoutStopSec=5s
