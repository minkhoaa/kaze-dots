[Unit]
Description=Kaze Hyprland Polkit authentication agent
PartOf=kaze-session.target
Requisite=kaze-session.target
After=kaze-session.target
ConditionPathExists=/usr/lib/hyprpolkitagent/hyprpolkitagent

[Service]
Type=simple
Slice=session.slice
EnvironmentFile=%t/kaze/session.env
ExecStart=/usr/lib/hyprpolkitagent/hyprpolkitagent
Restart=on-failure
RestartSec=1
TimeoutStopSec=5s
