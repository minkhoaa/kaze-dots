[Unit]
Description=Kaze Polkit authentication agent
PartOf=kaze-session.target
Requisite=kaze-session.target
After=kaze-session.target
ConditionFileIsExecutable=/usr/lib/mate-polkit/polkit-mate-authentication-agent-1
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=exec
EnvironmentFile=%t/kaze/session.env
ExecCondition=:/usr/bin/sh -c 'test "${KAZE_ENABLE_POLKIT:-0}" = 1'
ExecStart=/usr/lib/mate-polkit/polkit-mate-authentication-agent-1
Restart=on-failure
RestartSec=250ms
TimeoutStopSec=5s
