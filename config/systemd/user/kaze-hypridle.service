[Unit]
Description=Kaze Hypridle idle daemon
PartOf=kaze-session.target
Requisite=kaze-session.target
After=kaze-session.target
ConditionPathExists=/usr/bin/hypridle

[Service]
Type=simple
Slice=session.slice
EnvironmentFile=%t/kaze/session.env
ExecStart=/usr/bin/hypridle
Restart=on-failure
RestartSec=1
TimeoutStopSec=5s
