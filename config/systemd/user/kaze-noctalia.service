[Unit]
Description=Kaze Noctalia shell
PartOf=kaze-session.target
Requisite=kaze-session.target
After=kaze-session.target
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=exec
Slice=session.slice
EnvironmentFile=%t/kaze/session.env
Environment=MALLOC_CONF=background_thread:false,narenas:1,dirty_decay_ms:1000,muzzy_decay_ms:5000,lg_tcache_max:10
ExecStart=/usr/bin/noctalia
Restart=on-failure
RestartSec=250ms
TimeoutStopSec=5s
