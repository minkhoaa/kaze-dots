[Unit]
Description=Kaze clipboard history (%i)
PartOf=kaze-session.target
Requisite=kaze-session.target
After=kaze-session.target
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=exec
EnvironmentFile=%t/kaze/session.env
UMask=0077
ExecStart=/usr/bin/wl-paste --type %i --watch %h/.local/bin/kaze-clipboard store
Restart=on-failure
RestartSec=250ms
TimeoutStopSec=5s
