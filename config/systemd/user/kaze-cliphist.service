[Unit]
Description=Kaze Wayland clipboard history watcher (cliphist)
PartOf=kaze-session.target
Requisite=kaze-session.target
After=kaze-session.target
ConditionPathExists=/usr/bin/cliphist
ConditionPathExists=/usr/bin/wl-paste

[Service]
Type=simple
Slice=session.slice
EnvironmentFile=%t/kaze/session.env
ExecStart=/usr/bin/wl-paste --watch /usr/bin/cliphist store
Restart=on-failure
RestartSec=1
TimeoutStopSec=5s
